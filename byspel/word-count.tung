use deed/system.tung
use frame/algebra/total/magma.tung
use frame/functor/cata.tung
use ground.tung
use ilk/list.tung
use ilk/option.tung
use ilk/product.tung
use ilk/table.tung
use ilk/text/operation.tung

let count-word [counts:text table ℤ, word:text, text table ℤ]
  match counts lookup word {
    none ^ counts put word 1,
    count some ^ counts put word (count + 1)
  }

let count-words [content:text, text table ℤ] (
  let words = content words-text
  yield words fold₁ table~empty count-word
)

let write-count [entry:text ∏ ℤ, 𝟙; console] (
  let _ = (entry project₀) write
  let _ = ':' write
  yield (entry project₁) to-text $ write-line
)

let main [_:𝟙, 𝟙; console, file, system]
  match only arguments {
    list~empty ^ 'usage: tung word-count.tung <file>' write-line,
    paþ _* _ ^ try (
      let content = paþ read-file
      let counts = content count-words
      yield (counts entries) each write-count
    ) {
      message fail ^ 'error:' * message $ write-line
    }
  }
