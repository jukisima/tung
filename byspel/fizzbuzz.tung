bring ground.tung;
bring data/list.tung;
bring algebra/partial/semigroupoid.tung;

graith a divide, a multiply, a equal
let (divisor: a, dividend: a) can-divide: 𝟚 =
  try dividend ≡ (dividend ÷ divisor $ × divisor) {
    _ fail | nay
  };

kin fizzbuzz {
  fizz,
  buzz,
  fizzbuzz,
  integer raw
}

fill fizzbuzz to-text {
  let to-text = {
    fizz | 'fizz',
    buzz | 'buzz',
    fizzbuzz | 'fizzbuzz',
    i raw | i to-text
  }
}

let (i: integer) to-fizzbuzz: fizzbuzz =
  match 3 can-divide i, 5 can-divide i {
    yea, yea | fizzbuzz,
    yea, nay | fizz,
    nay, yea | buzz,
    nay, nay | i raw
  };

let _ main: 𝟙 ! console =
  0 till 32 $ map (to-fizzbuzz ∘ to-text) $ each write-line
