bring ground.tung;
bring data/list.tung;
bring data/product.tung;
bring algebra/partial/semigroupoid.tung;

graith a divide-remainder, a zero, a equal
let (divisor: a, dividend: a) can-divide: 𝟚 =
  try ((dividend ÷ divisor) project₁) ≡ zero {
    _ fail | nay
  };

kin fizzbuzz {
  fizz,
  buzz,
  fizzbuzz,
  integer raw
}

fill fizzbuzz to-text {
  let to-text = {
    fizz | 'fizz',
    buzz | 'buzz',
    fizzbuzz | 'fizzbuzz',
    i raw | i to-text
  }
}

let (integer: integer) to-fizzbuzz: fizzbuzz =
  match 3 can-divide integer, 5 can-divide integer {
    yea, yea | fizzbuzz,
    yea, nay | fizz,
    nay, yea | buzz,
    nay, nay | integer raw
  };

let _ main: 𝟙 ! console =
  0 till 32 $ map (to-fizzbuzz ∘ to-text) $ each write-line
