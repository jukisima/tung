use frame/algebra/partial/semigroupoid.tung
use ground.tung
use ilk/list.tung
use ilk/product.tung

graiþ a divide-remainder, a zero, a equal
let can-divide [divisor:a, dividend:a, 𝟚]
  try ((dividend % divisor) project₁) ≡ zero {
    _ fail ^ nay
  }

ilk fizzbuzz {
  fizz,
  buzz,
  fizzbuzz,
  ℤ raw
}

fill fizzbuzz to-text {
  let to-text = {
    fizz ^ 'fizz',
    buzz ^ 'buzz',
    fizzbuzz ^ 'fizzbuzz',
    i raw ^ i to-text
  }
}

let to-fizzbuzz [integer:ℤ, fizzbuzz]
  match 3 can-divide integer, 5 can-divide integer {
    yea, yea ^ fizzbuzz,
    yea, nay ^ fizz,
    nay, yea ^ buzz,
    nay, nay ^ integer raw
  }

let _ main [𝟙; console]
  0 till 32 $ map (to-fizzbuzz ∘ to-text) $ each write-line
