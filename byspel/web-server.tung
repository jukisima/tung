use frame/algebra/total/magma.tung
use ground.tung
use web/server.tung

let route [r:request, response; console] (
  let _ = ('request:' * (r request-target)) write-line
  yield match (r request-target) ≡ '/' {
    yea ^ 'hello tung\n' ok,
    nay ^ 'not found\n' not-found
  }
)

let main [_:𝟙, 𝟙; console, web]
  try 8080 serve route {
    message fail ^ 'web server:' * message $ write-line
  }
