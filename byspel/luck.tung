use ground.tung

let (_: 𝟙) read-user: float ! console =
  try (null read) from-text {
    _ fail | (
      let _ = 'could not read a float; using 0.0' write-line
      yield 0.0
    )
  }

let (_: 𝟙) main: 𝟙 ! console, random = (
  let _ = 'input a float between 0.0 and 1.0' write-line
  let user = null read-user
  let hidden = null random
  let outcome: text = match user ≤ hidden, hidden ≤ user {
    yea, nay | 'lose',
    nay, yea | 'win',
    _, _ | 'draw'
  }
  yield outcome write-line
)
