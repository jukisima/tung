{
  "name": "tung-vscode",
  "displayName": "tung",
  "description": "language support for tung source files",
  "version": "0.1.0",
  "publisher": "tung",
  "license": "UNLICENSED",
  "main": "./bundle/client/extension.js",
  "scripts": {
    "setup": "npm test && npm run install:extension",
    "prebuild": "node -e \"for (const directory of ['out', 'bundle']) require('node:fs').rmSync(directory, { recursive: true, force: true })\"",
    "build": "tsc --project tsconfig.json && npm run bundle",
    "bundle": "esbuild client/extension.ts server/main.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outdir=bundle --outbase=.",
    "check": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build --silent && npm run check:metadata --silent && node tool/run-tests.mjs",
    "check:metadata": "node tool/update-language-metadata.mjs --check",
    "update:metadata": "node tool/update-language-metadata.mjs",
    "package": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\" && vsce package --no-dependencies --readme-path readme.md --allow-missing-repository --skip-license --out dist/tung-vscode.vsix",
    "install:extension": "npm run package && code --install-extension dist/tung-vscode.vsix --force",
    "vscode:prepublish": "npm run build"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tung",
        "aliases": [
          "tung",
          "Tung"
        ],
        "extensions": [
          ".tung"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tung",
        "scopeName": "source.tung",
        "path": "./syntaxes/tung.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "tung.runFile",
        "title": "Run Tung File",
        "category": "Tung",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tung.runFile",
          "when": "resourceLangId == tung",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "tung.runFile",
          "when": "resourceLangId == tung",
          "group": "navigation@1"
        }
      ]
    },
    "semanticTokenTypes": [
      {
        "id": "frame",
        "superType": "type",
        "description": "tung frame name"
      },
      {
        "id": "call",
        "superType": "variable",
        "description": "term used in tung function position"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "applied",
        "description": "term or type used in function position"
      },
      {
        "id": "typeFunction",
        "description": "parameterised type or frame declaration"
      },
      {
        "id": "effect",
        "description": "effect operation or effect type"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "tung",
        "scopes": {
          "keyword": [
            "keyword.control.tung",
            "keyword.control"
          ],
          "namespace": [
            "entity.name.namespace.tung",
            "entity.name.namespace"
          ],
          "type": [
            "support.type.tung",
            "support.type"
          ],
          "type.effect": [
            "support.type.effect.tung",
            "support.type.effect",
            "support.type"
          ],
          "frame": [
            "support.type.tung",
            "support.type"
          ],
          "function": [
            "entity.name.function.tung",
            "entity.name.function"
          ],
          "method": [
            "entity.name.function.member.tung",
            "entity.name.function.member"
          ],
          "method.effect": [
            "entity.name.function.member.tung",
            "entity.name.function.member"
          ],
          "call": [
            "variable.other.tung",
            "variable.other"
          ],
          "call.effect": [
            "variable.other.tung",
            "variable.other"
          ],
          "variable": [
            "variable.other.tung",
            "variable.other"
          ],
          "variable.effect": [
            "variable.other.tung",
            "variable.other"
          ],
          "parameter": [
            "variable.parameter.tung",
            "variable.parameter"
          ],
          "property": [
            "variable.other.member.tung",
            "variable.other.member"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[tung]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "parameter:tung": {
            "italic": false
          },
          "type:tung": {
            "italic": false
          },
          "frame:tung": {
            "italic": false
          },
          "call.applied:tung": {
            "italic": true
          },
          "type.applied:tung": {
            "italic": true
          },
          "frame.applied:tung": {
            "italic": true
          },
          "typeParameter.applied:tung": {
            "italic": true
          },
          "type.typeFunction:tung": {
            "italic": true
          },
          "frame.typeFunction:tung": {
            "italic": true
          }
        }
      }
    },
    "configuration": {
      "title": "tung",
      "properties": {
        "tung.executablePath": {
          "type": "string",
          "default": "",
          "description": "absolute path to the tung compiler executable; defaults to a built compiler in tung.tonguePath or tung on PATH"
        },
        "tung.tonguePath": {
          "type": "string",
          "default": "",
          "description": "optional path to a tung compiler checkout containing tongue/tung.cabal or to its tongue folder"
        },
        "tung.libraryPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "additional absolute module-root directories searched after git-pinned project libraries"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vscode-jsonrpc": "8.2.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
