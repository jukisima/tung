{
  "comments": {
    "lineComment": "#",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["r(", ")"],
    ["<(", ")"],
    [">(", ")"],
    ["(", ")"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    ["(", ")"],
    ["{", "}"],
    ["'", "'"]
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["{", "}"],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "(?:\\{|\\()\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*[)}]"
  }
}
