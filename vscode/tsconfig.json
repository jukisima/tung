{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "rootDir": ".",
    "outDir": "out",
    "strict": false,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"]
  },
  "include": ["client/**/*.ts", "server/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "out"]
}
