{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "tung",
  "scopeName": "source.tung",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#character"
    },
    {
      "include": "#import-path"
    },
    {
      "include": "#type-export-list"
    },
    {
      "include": "#export-list"
    },
    {
      "include": "#data-declaration"
    },
    {
      "include": "#type-after-marker"
    },
    {
      "include": "#declaration-keyword"
    },
    {
      "include": "#control-keyword"
    },
    {
      "include": "#fremmed-marker"
    },
    {
      "include": "#primitive-type"
    },
    {
      "include": "#number"
    },
    {
      "include": "#qualified-name"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#name"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "match": "#.*$",
          "name": "comment.line.number-sign.tung"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.tung"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.tung"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.tung"
            }
          },
          "name": "string.quoted.single.tung",
          "patterns": [
            {
              "match": "\\\\(?:n|r|t|\\\\|'|[0-9]+;)",
              "name": "constant.character.escape.tung"
            }
          ]
        }
      ]
    },
    "character": {
      "patterns": [
        {
          "match": "`(?:\\\\(?:n|r|t|\\\\|'|[0-9]+;)|.)",
          "name": "constant.character.tung"
        }
      ]
    },
    "import-path": {
      "patterns": [
        {
          "match": "\\b(use)\\b(\\s+)([^\\s#]+)(?:([ \\t]+)([^\\s#]+))?",
          "captures": {
            "1": {
              "name": "keyword.declaration.tung"
            },
            "3": {
              "name": "string.unquoted.import-path.tung"
            },
            "5": {
              "name": "entity.name.namespace.tung"
            }
          },
          "name": "meta.import.tung"
        }
      ]
    },
    "export-list": {
      "patterns": [
        {
          "begin": "\\b(show)\\b(?=\\s+(?!let-ilk\\b|let\\b|graiþ\\b|ilk\\b|deed\\b|frame\\b|fill\\b))",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.tung"
            }
          },
          "end": "(?=\\b(?:use|graiþ|yield|show|show-ilk|let|let-ilk|ilk|deed|frame|fill)\\b)|$",
          "name": "meta.export.tung"
        }
      ]
    },
    "type-export-list": {
      "patterns": [
        {
          "begin": "\\b(show-ilk)\\b(?=\\s+)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.tung"
            }
          },
          "end": "(?=\\b(?:use|graiþ|yield|show|show-ilk|let|let-ilk|ilk|deed|frame|fill)\\b)|$",
          "name": "meta.export.type.tung",
          "patterns": [
            {
              "match": "[^\\s#(){}:,!=$→`']+|[+\\-×÷%≤≡¬∅∏∐*]",
              "name": "support.type.tung"
            },
            {
              "match": ",",
              "name": "punctuation.separator.tung"
            }
          ]
        }
      ]
    },
    "data-declaration": {
      "patterns": [
        {
          "match": "\\b(ilk)\\b(\\s+)([^\\s#(){}:,!=$→`']+)(\\s+)([^\\s#(){}:,!=$→`']+)(?=(?:\\s+[^\\s#(){}:,!=$→`']+)*\\s*\\{)",
          "captures": {
            "1": {
              "name": "keyword.declaration.tung"
            },
            "5": {
              "name": "support.type.tung"
            }
          },
          "name": "meta.declaration.data.tung"
        },
        {
          "match": "\\b(ilk)\\b(\\s+)([^\\s#(){}:,!=$→`']+)(?=\\s*\\{)",
          "captures": {
            "1": {
              "name": "keyword.declaration.tung"
            },
            "3": {
              "name": "support.type.tung"
            }
          },
          "name": "meta.declaration.data.tung"
        }
      ]
    },
    "type-after-marker": {
      "patterns": [
        {
          "match": "(?<!\\)\\s*:)(?<=[:→!])(\\s*)([^\\s#(){}:,!=$→`']+)",
          "captures": {
            "2": {
              "name": "support.type.tung"
            }
          }
        }
      ]
    },
    "declaration-keyword": {
      "patterns": [
        {
          "match": "\\b(?:let-ilk|let|graiþ|use|ilk|deed|frame|fill|law|show-ilk|show)\\b",
          "name": "keyword.declaration.tung"
        }
      ]
    },
    "control-keyword": {
      "patterns": [
        {
          "match": "\\b(?:yield|match|try|eftgin)\\b",
          "name": "keyword.control.tung"
        }
      ]
    },
    "fremmed-marker": {
      "patterns": [
        {
          "match": "\\bfremmed\\b",
          "name": "keyword.other.tung"
        }
      ]
    },
    "primitive-type": {
      "patterns": [
        {
          "match": "\\b(?:integer|float|text|unicode|func)\\b",
          "name": "support.type.tung"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "(?<![^\\s#(){}:,!=$→`'])-?[0-9]+\\.[0-9]+(?![^\\s#(){}:,!=$→`'])",
          "name": "constant.numeric.float.tung"
        },
        {
          "match": "(?<![^\\s#(){}:,!=$→`'])-?[0-9]+(?![^\\s#(){}:,!=$→`'])",
          "name": "constant.numeric.integer.tung"
        }
      ]
    },
    "qualified-name": {
      "patterns": [
        {
          "match": "(?<![^\\s#(){}:,!=$→`'])([^\\s#(){}:,!=$→`'./]+)(\\.)(\\.\\*|[^\\s#(){}:,!=$→`'./]+)(?![^\\s#(){}:,!=$→`'])",
          "captures": {
            "1": {
              "name": "entity.name.namespace.tung"
            },
            "2": {
              "name": "punctuation.accessor.tung"
            },
            "3": {
              "name": "variable.other.tung"
            }
          }
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "match": "→|!|\\$|~",
          "name": "keyword.operator.tung"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.tung"
        },
        {
          "match": "@|\\|",
          "name": "keyword.operator.arrow.case.tung"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "(?<![^\\s#(){}:,!=$→`'])(?:r|[<>])\\(",
          "name": "punctuation.section.parens.begin.tung"
        },
        {
          "match": "[(){}]",
          "name": "punctuation.section.tung"
        },
        {
          "match": "[:,]",
          "name": "punctuation.separator.tung"
        }
      ]
    },
    "name": {
      "patterns": [
        {
          "match": "\\.\\*|[^\\s#(){}:,!=$→`']+|[+\\-×÷%≤≡¬∅∏∐*]",
          "name": "variable.other.tung"
        }
      ]
    }
  }
}
