bring data/two.tung;
bring algebra/total/monoid.tung;
bring algebra/total/semigroup.tung;

show kin disjunctive {
  𝟚 disjunctive
}

fill disjunctive semigroup {
  let (x: disjunctive, y: disjunctive) *: disjunctive = match x, y {
    yea disjunctive, _ | yea disjunctive,
    _, yea disjunctive | yea disjunctive,
    _, _ | nay disjunctive
  }
}

fill disjunctive monoid {
  let ∅ = nay disjunctive
}
