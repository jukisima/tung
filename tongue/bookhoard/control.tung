bring data/one.tung;
bring data/two.tung;

## run an action when the condition is true.
show let (two: 𝟚, f: 𝟙 → 𝟙 ! e) when: 𝟙 ! e =
  match two {
    yea | null f,
    nay | null
  };

## run an action when the condition is false.
show let (two: 𝟚, f: 𝟙 → 𝟙 ! e) when-not: 𝟙 ! e = (two ¬) when f

## pick and run one delayed branch.
show let (two: 𝟚, f: 𝟙 → a ! e0, g: 𝟙 → a ! e1) branch: a ! e0, e1 =
  match two {
    yea | null f,
    nay | null g
  }
