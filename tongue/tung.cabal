cabal-version: 3.0
name: tung
version: 0.1.0.0
build-type: Simple

common warnings
  ghc-options: -Wall -Wno-name-shadowing -Wno-unused-do-bind
  default-extensions:
      BlockArguments
    , DerivingStrategies
    , GeneralizedNewtypeDeriving
    , LambdaCase
    , ImportQualifiedPost
    , NamedFieldPuns
    , RecordWildCards
    , TupleSections

library
  import: warnings
  exposed-modules: Tung
  other-modules:
      Tung.Evaluate
    , Tung.Import
    , Tung.Library
    , Tung.Name
    , Tung.Parse
    , Tung.Syntax
    , Tung.Token
    , Tung.Type
    , Tung.Validate
  hs-source-dirs: src
  default-language: Haskell2010
  build-depends:
      base >=4.20 && <5
    , containers
    , directory
    , filepath
    , megaparsec
    , time
    , transformers

executable tung
  import: warnings
  main-is: Main.hs
  hs-source-dirs: app
  default-language: Haskell2010
  build-depends:
      base >=4.20 && <5
    , containers
    , directory
    , filepath
    , tung

test-suite tung-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules:
      Test.Evaluate
    , Test.Harness
    , Test.Import
    , Test.Integration
    , Test.Library
    , Test.Name
    , Test.Parse
    , Test.Token
    , Test.Type
    , Test.Validate
  default-language: Haskell2010
  build-depends:
      base >=4.20 && <5
    , containers
    , directory
    , tung
