bring two.tung;
bring equal.tung;

graith a equal
show shape a order {
  a ≤ a: 𝟚;
  let a < b = match a ≤ b {
    yea | a ≢ b,
    nay | nay
  };
  let a ∧ b = match a ≤ b {
    yea | a,
    nay | b
  };
  let a ∨ b = match a ≤ b {
    yea | b,
    nay | a
  }
}

fill 𝟚 order {
  let ≤ = {
    nay, _ | yea,
    yea, a | a
  }
}
