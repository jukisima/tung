bring ground.jbini;
bring product.jbini;
bring algebra/semigroup.jbini;
bring algebra/monoid.jbini;
bring natural.jbini;
bring collection/size.jbini;
bring collection/catamorphism.jbini;
bring collection/applicative.jbini;
bring collection/monad.jbini;
bring collection/filter.jbini;

data a list {
  empty,
  a .* (a list)
}

let (start: integer, stop: integer) till: integer list = match start ≤ stop {
  yea | start .* ((start + 1) till stop),
  nay | empty
};

flesh (a list) semigroup {
  let a… * b… = match a… {
    empty | b…,
    a .* l | a .* (l * b…)
  }
}

flesh (a list) monoid {
  let ∅ = empty
}

flesh list functor {
  let it map f = match it {
    empty | empty,
    a .* l | (a f) .* (l map f)
  }
}

flesh list monad {
  let a pure = a .* empty;
  let a… apply f… = match f… {
    empty | empty,
    f .* fs | (a… map f) * (a… apply fs)
  };
  let a…… flat = match a…… {
    empty | empty,
    a… .* rest | a… * (rest flat)
  };
  let a… map-flat f = (a… map f) flat
}

flesh list filter {
  let x filter f = match x {
    empty | empty,
    a .* l | (a f) if (a .* (l filter f)) (l filter f)
  }
}

let (items: a list, action: a → 𝟙 ! e) each: 𝟙 ! e = match items {
  empty | null,
  item .* rest | (
    let _ = item action;
    rest each action
  )
}

flesh list cata {
  let a… foldr b f = match a… {
    empty | b,
    a .* rest | a f (rest foldr b f)
  };
  let a… foldl b f = match a… {
    empty | b,
    a .* rest | rest foldl (b f a) f
  }
}

flesh (a list) size {
  let l size = l foldl natural@zero ({ n, _ | n suc })
}

let reverse: a list → a list = (
  let help = {
    result, empty | result,
    result, a .* l | (a .* result) help l
  };
  empty help
);

let every: 𝟚 list → 𝟚 = {
  empty | yea,
  yea .* l | l every,
  nay .* _ | nay
};

let some: 𝟚 list → 𝟚 = {
  empty | nay,
  nay .* l | l some,
  yea .* _ | yea
};

let zip: a list → b list → (a ∏ b) list = {
  empty, _ | empty,
  _, empty | empty,
  a .* a…, b .* b… | (a ∏ b) .* (a… zip b…)
}
