bring foreign.jbini;
bring algebra/field.jbini;
bring numeric/constant.jbini;

given a field
bone a elementary {
  a exponent: a;
  a logarithm: a;
  a sine: a;
  a cosine: a;
  let (a: a) tangent: a ! string fail = a sine $÷ a cosine
}

flesh float elementary {
  let exponent = exponent-float;
  let logarithm = logarithm-float;
  let sine = sine-float;
  let a cosine = circumference × 0.25 $- a $sine;
}
