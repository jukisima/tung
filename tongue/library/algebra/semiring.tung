bring foreign.tung;
bring two.tung;

show shape a add {
  a + a: a
}

show shape a zero {
  zero: a
}

show shape a multiply {
  a × a: a
}

show shape a one {
  one: a
}

graith a add, a zero, a multiply, a one
show shape a semiring {}

graith b semiring
fill (a func b) semiring {
  let f + g = { a | (a f) + (a g) };
  let zero = { a | zero };
  let f × g = { a | (a f) × (a g) };
  let one = { a | one }
}

fill integer semiring {
  let + = add-integer;
  let zero = 0;
  let × = multiply-integer;
  let one = 1;
}

fill float semiring {
  let + = add-float;
  let zero = 0.0;
  let × = multiply-float;
  let one = 1.0;
}

fill 𝟚 add {
  let a + b = match a, b {
    yea, nay | yea,
    nay, yea | yea,
    _, _ | nay
  }
}
