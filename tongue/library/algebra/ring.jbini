bring algebra/semiring.jbini;
bring foreign.jbini;

given a add
bone a subtract {
  a - a: a
}

given a semiring, a subtract
bone a ring {}

given b ring
flesh (a func b) ring {
  let f - g = { a | (a f) - (a g) }
}

flesh integer subtract {
  let - = subtract-integer
}

flesh float subtract {
  let - = subtract-float
}

flesh integer ring {}

flesh float ring {}
