bring two.tung;
bring algebra/semigroup.tung;
bring algebra/monoid.tung;
bring collection/functor.tung;
bring collection/applicative.tung;
bring collection/monad.tung;
bring collection/filter.tung;

show choose a option {
  none,
  a some
}

graith a semigroup
fill (a option) semigroup {
  let * = {
    none, b | b,
    a, none | a,
    a some, b some | a * b $ some
  }
}

graith a semigroup
fill (a option) monoid {
  let ∅ = none
}

fill option functor {
  let option map f = match option {
    none | none,
    a some | a f $ some
  }
}

fill option applicative {
  let pure = some;
  let apply = {
    a some, f some | a f $ some,
    _, _ | none
  }
}

fill option monad {
  let flat = {
    none | none,
    a some | a
  };
  let a map-flat f = a map f $ flat
}

fill option filter {
  let option filter f = match option {
    none | none,
    a some | a f $ if (a some) none
  }
}

show let default: a option → a → a = {
  none, b | b,
  a some, _ | a
}
