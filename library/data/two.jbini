bring string.jbini;
bring string/to-string.jbini;
bring algebra/semigroup.jbini;
bring algebra/monoid.jbini;

data 𝟚 {
  yea,
  nay
}

let ¬: 𝟚 → 𝟚 = {
  yea | nay,
  nay | yea
};

let if: 𝟚 → a → a → a = {
  yea, then, _ | then,
  nay, _, else | else
};

flesh 𝟚 equal {
  let ≡ = {
    yea, yea | yea,
    nay, nay | yea,
    _, _ | nay
  }
}

flesh 𝟚 order {
  let ≤ = {
    nay, _ | yea,
    yea, a | a
  }
}

flesh 𝟚 add {
  let a + b = match a, b {
    yea, nay | yea,
    nay, yea | yea,
    _, _ | nay
  }
}

flesh 𝟚 to-string {
  let a to-string = match a {
    yea | 'yea',
    nay | 'nay'
  }
}

data disjunctive {
  𝟚 disjunctive
}

data conjunctive {
  𝟚 conjunctive
}

flesh disjunctive semigroup {
  let (x: disjunctive, y: disjunctive) *: disjunctive = match x, y {
    yea disjunctive, _ | yea disjunctive,
    _, yea disjunctive | yea disjunctive,
    _, _ | nay disjunctive
  }
}

flesh disjunctive monoid {
  let ∅ = nay disjunctive
}

flesh conjunctive semigroup {
  let (x: conjunctive, y: conjunctive) *: conjunctive = match x, y {
    nay conjunctive, _ | nay conjunctive,
    _, nay conjunctive | nay conjunctive,
    _, _ | yea conjunctive
  }
}

flesh conjunctive monoid {
  let ∅ = yea conjunctive
}
