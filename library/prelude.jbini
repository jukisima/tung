data 𝟘 {}

data 𝟙 {
  null
}

data 𝟚 {
  yea,
  nay
}

let ¬: 𝟚 → 𝟚 = {
  yea ↦ nay,
  nay ↦ yea
};

let (condition: 𝟚, then: a, else: a) if: a = match condition {
  yea ↦ then,
  nay ↦ else
};

data a ∏ b {
  a ∏ b
}

let project₀: a ∏ b → a = {
  a ∏ _ ↦ a
}

let project₁: a ∏ b → b = {
  _ ∏ b ↦ b
}

data a ∐ b {
  a inject₀,
  b inject₁
}

data a option {
  none,
  a some
}

data a list {
  empty,
  a .* (a list)
}

data a task {
  a done
}

type string = character list;

effect e fail {
  fail: e → a
}

effect console {
  write: string → 𝟙,
  read: 𝟙 → string
}

effect random {
  random: 𝟙 → float
}

effect a state {
  get: 𝟙 → a,
  set: a → 𝟙
}

effect async {
  fork: (𝟙 → a) → a task,
  wait: a task → a,
  sleep: integer → 𝟙
}

bone a equal {
  a ≡ a: 𝟚;
  let a ≢ b = (a ≡ b) ¬
}

flesh 𝟚 equal {
  let a ≡ b = match a {
    yea ↦ b,
    nay ↦ b ¬
  }
}

given a equal bone a order {
  a ≤ a: 𝟚;
  let a < b = match a ≤ b {
    yea ↦ a ≢ b,
    nay ↦ nay
  };
  let a ∧ b = match a ≤ b {
    yea ↦ a,
    nay ↦ b
  };
  let a ∨ b = match a ≤ b {
    yea ↦ b,
    nay ↦ a
  }
}

flesh 𝟚 order {
  let a ≤ b = match a {
    yea ↦ b,
    nay ↦ yea
  }
}

bone a add {
  a + a: a
}

flesh 𝟚 add {
  let a + b = match a, b {
    yea, nay ↦ yea,
    nay, yea ↦ yea,
    _, _ ↦ nay
  }
}

bone a zero {
  zero: a
}

bone a negate {
  a ¯: a
}

given a add, a negate bone a subtract {
  let (a: a, b: a) -: a = a + (b ¯)
}

bone a multiply {
  a × a: a
}

bone a one {
  one: a
}

given a add, a zero, a multiply, a one bone a semiring {}

given a semiring, a negate bone a ring {}

bone a reciprocalise {
  a /: a ! string fail
}

given a multiply, a reciprocalise bone a divide {
  let (a: a, b: a) ÷
    : a ! string fail
    = a × (b /)
}

bone a mod {
  a mod a: a ∏ a;
  let a quotient b = (a mod b) project₀;
  let a remainder b = (a mod b) project₁
}

given a ring, a reciprocalise bone a field {}
