data a task {
  a done
}

effect e fail {
  e fail: a
}

effect console {
  string write: 𝟙,
  𝟙 read: string
}

effect random {
  𝟙 random: float
}

effect a state {
  𝟙 get: a,
  a set: 𝟙
}

effect async {
  (𝟙 → a) fork: a task,
  (a task) wait: a,
  integer sleep: 𝟙
}

class foreign {
  integer add-integer integer: integer;
  integer subtract-integer integer: integer;
  integer multiply-integer integer: integer;
  integer divide-integer integer: integer ! string fail;
  float add-float float: float;
  float subtract-float float: float;
  float multiply-float float: float;
  float divide-float float: float ! string fail;
  float sine: float;
  float exponent: float;
  float logarithm: float;
  float ⌊: integer;
  integer equal-integer integer: 𝟚;
  integer integer-to-string: string;
  float float-to-string: string;
}
