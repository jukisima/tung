bring prelude.jbini;

data natural {
  zero,
  natural suc
}

flesh natural equal {
  let a ≡ b = match a, b {
    zero, zero ↦ yea,
    a1 suc, b1 suc ↦ a1 ≡ b1,
    _, _ ↦ nay
  }
}

flesh natural order {
  let a ≤ b = match a, b {
    zero, _ ↦ yea,
    _, zero ↦ nay,
    a1 suc, b1 suc ↦ a1 ≤ b1
  }
}

flesh natural add {
  let a + = {
    zero ↦ a,
    b suc ↦ (a + b) suc
  }
}

flesh natural multiply {
  let a × = {
    zero ↦ zero,
    b suc ↦ a + (a × b)
  }
}
