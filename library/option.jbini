bring prelude.jbini;
bring monad.jbini;

flesh option functor {
  it map f = match it {
    none ↦ none,
    a some ↦ (a f) some
  }
}

flesh option applicative {
  a pure = a some,
  it apply maybe-function = match it, maybe-function {
    a some, f some ↦ (a f) some,
    _, _ ↦ none
  }
}

flesh option monad {
  flat = match {
    none ↦ none,
    inner some ↦ inner
  },
  it bind f = (it map f) flat
}

flesh option filter {
  it filter f = match it {
    none ↦ none,
    a some ↦ (a f) if (a some) none
  }
}
