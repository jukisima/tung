bring prelude.jbini;

bone f functor {
  (a f) map (a → b ! e): b f ! e
}

bone f applicative need f functor {
  a pure: a f,
  (a f) apply ((a → b ! e) f): b f ! e
}

bone f monad need f applicative {
  ((a f) f) flat: a f,
  let (a: a f, f: a → b f ! e) bind: b f ! e = (a map f) flat

  # (a pure) f bind = a f
  # a pure bind = a
}

bone f filter need f functor {
  (a f) filter (a → 𝟚 ! e): a f ! e
}

