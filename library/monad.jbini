bring prelude.jbini;

bone f functor {
  (a f) map (a → b ! e): b f ! e
}

given f functor bone f applicative {
  a pure: a f;
  (a f) apply ((a → b ! e) f): b f ! e
}

given f applicative bone f monad {
  ((a f) f) flat: a f;
  let (a: a f, f: a → b f ! e) map-flat: b f ! e = (a map f) flat

  # (a pure) f map-flat = a f
  # a pure map-flat = a
}

given f functor bone f filter {
  (a f) filter (a → 𝟚 ! e): a f ! e
}
