bring prelude.jbini;

data a complex {
  a complex a
}

flesh (a complex) add {
  (a complex b) + (c complex d) = (a + c) complex (b + d)
}

flesh (a complex) zero {
  zero = zero complex zero
}

flesh (a complex) negate {
  (a complex b) ¯ = (a ¯) complex (b ¯)
}

flesh (a complex) multiply {
  (a complex b) × (c complex d) = ((a × c) - (b × d)) complex ((a × d) + (b × c))
}

flesh (a complex) one {
  one = one complex zero
}

flesh (a complex) reciprocalise {
  (a complex b) / =  (
    let c = (a × a) + (b × b);
    (a ÷ c) complex ((b ÷ c) ¯)
  )
}
