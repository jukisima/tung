bring prelude.jbini;

data a complex {
  a complex a
}

given a add flesh (a complex) add {
  let (a complex b) + (c complex d) = (a + c) complex (b + d)
}

given a zero flesh (a complex) zero {
  let zero = zero complex zero
}

given a negate flesh (a complex) negate {
  let (a complex b) ¯ = (a ¯) complex (b ¯)
}

given a add, a negate, a multiply flesh (a complex) multiply {
  let (a complex b) × (c complex d) = ((a × c) + ((b × d) ¯)) complex ((a × d) + (b × c))
}

given a one, a zero flesh (a complex) one {
  let one = one complex zero
}

given a add, a negate, a multiply, a divide flesh (a complex) reciprocalise {
  let (a complex b) / =  (
    let c = (a × a) + (b × b);
    (a ÷ c) complex ((b ÷ c) ¯)
  )
}
