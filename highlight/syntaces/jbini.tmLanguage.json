{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "jbini",
  "scopeName": "source.jbini",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#character"
    },
    {
      "include": "#import-path"
    },
    {
      "include": "#declaration-keyword"
    },
    {
      "include": "#control-keyword"
    },
    {
      "include": "#effect-keyword"
    },
    {
      "include": "#primitive-type"
    },
    {
      "include": "#number"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#name"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "match": "#.*$",
          "name": "comment.line.number-sign.jbini"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.jbini"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.jbini"
            }
          },
          "name": "string.quoted.single.jbini",
          "patterns": [
            {
              "match": "\\\\(?:n|r|t|\\\\|'|\\{[0-9]+\\})",
              "name": "constant.character.escape.jbini"
            }
          ]
        }
      ]
    },
    "character": {
      "patterns": [
        {
          "match": "`(?:\\\\(?:n|r|t|\\\\|'|\\{[0-9]+\\})|\\{[0-9]+\\}|.)",
          "name": "constant.character.jbini"
        }
      ]
    },
    "import-path": {
      "patterns": [
        {
          "match": "(?<=\\bbring\\s)[^\\s;#]+",
          "name": "string.unquoted.import-path.jbini"
        }
      ]
    },
    "declaration-keyword": {
      "patterns": [
        {
          "match": "\\b(?:let|given|bring|type|data|effect|bone|flesh|class|foreign|show-type|show)\\b",
          "name": "keyword.declaration.jbini"
        }
      ]
    },
    "control-keyword": {
      "patterns": [
        {
          "match": "\\b(?:match|try|return|resume)\\b",
          "name": "keyword.control.jbini"
        }
      ]
    },
    "effect-keyword": {
      "patterns": [
        {
          "match": "\\b(?:console|random|async|file|fail|state|divergent)\\b",
          "name": "support.type.effect.jbini"
        }
      ]
    },
    "primitive-type": {
      "patterns": [
        {
          "match": "\\b(?:integer|float|string|character|char|func)\\b|[𝟘𝟙𝟚]",
          "name": "support.type.primitive.jbini"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "(?<![^\\s#(){}\\[\\]:,|!=;.$→`'])-?[0-9]+\\.[0-9]+(?![^\\s#(){}\\[\\]:,|!=;.$→`'])",
          "name": "constant.numeric.float.jbini"
        },
        {
          "match": "(?<![^\\s#(){}\\[\\]:,|!=;.$→`'])-?[0-9]+(?![^\\s#(){}\\[\\]:,|!=;.$→`'])",
          "name": "constant.numeric.integer.jbini"
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "match": "→|!|\\$|@",
          "name": "keyword.operator.jbini"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.jbini"
        },
        {
          "match": "\\|",
          "name": "keyword.operator.arrow.case.jbini"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.import-path.jbini"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[(){}\\[\\]]",
          "name": "punctuation.section.jbini"
        },
        {
          "match": "[:,;]",
          "name": "punctuation.separator.jbini"
        }
      ]
    },
    "name": {
      "patterns": [
        {
          "match": "\\.\\*|[^\\s#(){}\\[\\]:,|!=;.$→`']+|[+\\-×÷≤≡¬∅∏∐*]",
          "name": "entity.name.jbini"
        }
      ]
    }
  }
}
