bring ground.jbini;
bring list.jbini;

given a divide, a multiply, a equal
let (divisor: a, divided: a) can-divide: 𝟚 =
  try divided ≡ (divided ÷ divisor $ × divisor) {
    _ fail | nay
  };

let (i: integer) fizzbuzz: string =
  match 3 can-divide i, 5 can-divide i {
    yea, yea | 'fizzbuzz',
    yea, nay | 'fizz',
    nay, yea | 'buzz',
    nay, nay | i to-string
  };

0 till 32 $ map fizzbuzz $ each write-line
