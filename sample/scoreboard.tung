bring ground.tung;
bring list.tung;
bring option.tung;

choose verdict {
  pass,
  miss
}

let parse-score: string → float option = { raw |
  try (raw from-string) option@some {
    _ fail | none
  }
};

let score-verdict: float option → verdict = {
  none | miss,
  score option@some | match 0.5 ≤ score {
    yea | pass,
    nay | miss
  }
};

let count-pass: verdict list → integer = {
  empty | 0,
  pass .* rest | 1 + (rest count-pass),
  miss .* rest | rest count-pass
};

let parse-all: string list → (float option) list = {
  empty | empty,
  raw .* rest | (raw parse-score) .* (rest parse-all)
};

let grade-all: (float option) list → verdict list = {
  empty | empty,
  score .* rest | (score score-verdict) .* (rest grade-all)
};

let raw-scores: string list =
  '0.75' .* ('bad' .* ('0.20' .* ('0.90' .* empty)));

let scores: (float option) list = raw-scores parse-all;
let verdicts: verdict list = scores grade-all;

let summary =
  [name = 'cohort-a', pass-count = verdicts count-pass, last = (0.5 option@some) score-verdict];

let public-summary =
  [= summary, last = (0.5 option@some) score-verdict, - name];

let _ = 'scoreboard' write-line;
((verdicts count-pass) to-string) write-line
