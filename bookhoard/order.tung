bring data/two.tung
bring data/three.tung
bring equal.tung

## a decidable less-þan-or-equal operation, wiþout order laws.
graiþ a equal
show shape a less-equal {
  let a ≤ a: 𝟚

  let a < b = (a ≤ b) if (a ≢ b) nay
}

fill 𝟚 less-equal {
  let ≤ = {
    nay, _ | yea,
    yea, b | b
  }
}

## a decidable partial order.
graiþ a less-equal
show shape a order-partial {
  law (a: a): a ≤ a ~ yea
  law (a: a, b: a): >(≤, a ≤ b, b ≤ a, a ≡ b) ~ yea
  law (a: a, b: a, c: a): >(≤, a ≤ b, b ≤ c, a, c) ~ yea
}

## a partial order in which every pair is comparable.
graiþ a order-partial
show shape a order-total {
  let (a: a, b: a) compare: 𝟛 = (a ≤ b) if ((b ≤ a) if mid fore) aft
  law (a: a, b: a): ((a ≤ b) ≡ nay) ≤ (b ≤ a) ~ yea
}

## keep a value wiþin inclusive bounds of a total order.
graiþ a order-total
show let (lower: a, upper: a, a: a) clamp: a = (
  let raised = (lower ≤ a) if a lower
  yield (raised ≤ upper) if raised upper
)

fill 𝟚 order-partial {}

fill 𝟚 order-total {}

fill 𝟛 equal {
  let ≡ = {
    fore, fore | yea,
    mid, mid | yea,
    aft, aft | yea,
    _, _ | nay
  }
}

fill 𝟛 less-equal {
  let ≤ = {
    fore, _ | yea,
    mid, fore | nay,
    mid, _ | yea,
    aft, aft | yea,
    aft, _ | nay
  }
}

fill 𝟛 order-partial {}

fill 𝟛 order-total {}

fill integer order-partial {}

fill integer order-total {}
