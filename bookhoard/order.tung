use ilk/two.tung
use ilk/three.tung
use equal.tung

## a decidable less-þan-or-equal operation, wiþout order laws.
graiþ a equal
show frame a less-equal {
  let a ≤ a: 𝟚
}

graiþ a less-equal, a equal
show let (a: a, b: a) <: 𝟚 = (a ≤ b) if (a ≢ b) nay

fill 𝟚 less-equal {
  let ≤ = {
    nay, _ @ yea,
    yea, b @ b
  }
}

## a decidable partial order.
graiþ a less-equal
show frame a order-partial {
  law (a: a): a ≤ a ~ yea
  law (a: a, b: a): >(≤, a ≤ b, b ≤ a, a ≡ b) ~ yea
  law (a: a, b: a, c: a): >(≤, a ≤ b, b ≤ c, a, c) ~ yea
}

## a partial order in which every pair is comparable.
graiþ a order-partial
show frame a order-total {
  law (a: a, b: a): ((a ≤ b) ≡ nay) ≤ (b ≤ a) ~ yea
}

graiþ a order-total, a less-equal
show let (a: a, b: a) compare: 𝟛 = (a ≤ b) if ((b ≤ a) if mid fore) aft

## keep a value wiþin inclusive bounds of a total order.
graiþ a order-total
show let (lower: a, upper: a, a: a) clamp: a = (
  let raised = (lower ≤ a) if a lower
  yield (raised ≤ upper) if raised upper
)

fill 𝟚 order-partial {}

fill 𝟚 order-total {}

fill 𝟛 equal {
  let ≡ = {
    fore, fore @ yea,
    mid, mid @ yea,
    aft, aft @ yea,
    _, _ @ nay
  }
}

fill 𝟛 less-equal {
  let ≤ = {
    fore, _ @ yea,
    mid, fore @ nay,
    mid, _ @ yea,
    aft, aft @ yea,
    aft, _ @ nay
  }
}

fill 𝟛 order-partial {}

fill 𝟛 order-total {}

fill ℤ order-partial {}

fill ℤ order-total {}
