bring data/two.tung
bring data/three.tung
bring equal.tung

## a decidable less-than-or-equal operation, without order laws.
graith a equal
show shape a less-equal {
  let a ≤ a: 𝟚
  let a < b = (a ≤ b) if (a ≢ b) nay
}

fill 𝟚 less-equal {
  let ≤ = {
    nay, _ | yea,
    yea, b | b
  }
}

## a decidable partial order.
graith a less-equal
show shape a order-partial {
  law (x: a): x ≤ x ~ yea
  law (x: a, y: a): (x ≤ y) ≤ ((y ≤ x) ≤ (x ≡ y)) ~ yea
  law (x: a, y: a, z: a): (x ≤ y) ≤ ((y ≤ z) ≤ (x ≤ z)) ~ yea
}

## a partial order in which every pair is comparable.
graith a order-partial
show shape a order-total {
  let (a: a, b: a) compare: 𝟛 = (a ≤ b) if ((b ≤ a) if mid fore) aft
  law (x: a, y: a): ((x ≤ y) ≡ nay) ≤ (y ≤ x) ~ yea
}

## keep a value within inclusive bounds of a total order.
graith a order-total
show let (lower: a, upper: a, a: a) clamp: a = (
  let raised = (lower ≤ a) if a lower
  yield (raised ≤ upper) if raised upper
)

fill 𝟚 order-partial {}

fill 𝟚 order-total {}

fill 𝟛 equal {
  let ≡ = {
    fore, fore | yea,
    mid, mid | yea,
    aft, aft | yea,
    _, _ | nay
  }
}

fill 𝟛 less-equal {
  let ≤ = {
    fore, _ | yea,
    mid, fore | nay,
    mid, _ | yea,
    aft, aft | yea,
    aft, _ | nay
  }
}

fill 𝟛 order-partial {}

fill 𝟛 order-total {}

fill integer order-partial {}

fill integer order-total {}
