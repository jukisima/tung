bring data/two.tung
bring order.tung
bring algebra/arithmetic/ring.tung

show shape a absolute b {
  let a absolute: b
}

fill integer absolute integer {
  let integer absolute = (0 ≤ integer) if integer (0 - integer)
}

fill float absolute float {
  let float absolute = (0.0 ≤ float) if float (0.0 - float)
}
