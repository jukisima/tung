bring _foreign.tung;
bring algebra/arithmetic/semiring.tung;
bring algebra/arithmetic/ring.tung;
bring algebra/arithmetic/field.tung;
bring numeric/absolute.tung;
bring numeric/elementary.tung;

show kin a complex {
  a complex a
}

show let (a complex _: a complex) real: a = a;

show let (_ complex b: a complex) imaginary: a = b;

graith a zero, a one
show let unit: a complex = zero complex one;

graith a add
fill (a complex) add {
  let (a complex b) + (c complex d) = (a + c) complex (b + d)
}

graith a zero
fill (a complex) zero {
  let zero = zero complex zero
}

graith a subtract
fill (a complex) subtract {
  let (a complex b) - (c complex d) = (a - c) complex (b - d)
}

graith a subtract, a multiply
fill (a complex) multiply {
  let (a complex b) × (c complex d) = ((a × c) - (b × d)) complex ((a × d) + (b × c))
}

graith a one, a zero
fill (a complex) one {
  let one = one complex zero
}

graith a subtract, a multiply, a divide
fill (a complex) divide {
  let (a complex b) ∕ (c complex d) =  (
    let e = c × c $ + (d × d);
    (a × c $ + (b × d) $ ∕ e) complex (b × c $ - (a × d) $ ∕ e)
  )
}

graith a add, a multiply
fill (a complex) a absolute {
  let (a complex b) absolute = (a × a) + (b × b)
}

fill (float complex) elementary {
  let (a complex b) exponent = (
    let c = a exponent;
    (c × (b cosine)) complex (c × (b sine))
  );
  let (a complex b) logarithm = (a × a $ + (b × b) $ logarithm) complex (a arctan-float b);
  let (a complex b) sine = (
    let positive = ((zero - b) complex a) exponent;
    let negative = (b complex (zero - a)) exponent;
    (((positive imaginary) - (negative imaginary)) × 0.5)
    complex (((negative real) - (positive real)) × 0.5)
  );
  let (a complex b) cosine = (
    let positive = ((zero - b) complex a) exponent;
    let negative = (b complex (zero - a)) exponent;
    (((positive real) + (negative real)) × 0.5)
    complex (((positive imaginary) + (negative imaginary)) × 0.5)
  );
}
