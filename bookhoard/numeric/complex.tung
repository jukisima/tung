use _foreign.tung
use algebra/arithmetic/semiring.tung
use algebra/arithmetic/ring.tung
use algebra/arithmetic/field.tung
use numeric/absolute.tung
use numeric/elementary.tung

show ilk a complex {
  a complex a
}

show let (a complex _: a complex) real: a = a

show let (_ complex b: a complex) imaginary: a = b

graiþ a zero, a one
show let unit: a complex = zero complex one

graiþ a add
fill (a complex) add {
  let (a complex b) + (c complex d) = (a + c) complex (b + d)
}

graiþ a zero
fill (a complex) zero {
  let zero = zero complex zero
}

graiþ a subtract
fill (a complex) subtract {
  let (a complex b) - (c complex d) = (a - c) complex (b - d)
}

graiþ a subtract, a multiply
fill (a complex) multiply {
  let (a complex b) × (c complex d) = ((a × c) - (b × d)) complex ((a × d) + (b × c))
}

graiþ a one, a zero
fill (a complex) one {
  let one = one complex zero
}

graiþ a subtract, a multiply, a divide
fill (a complex) divide {
  let (a complex b) ÷ (c complex d) =  (
    let e = c × c $ + (d × d)
    yield ((a × c) + (b × d) $ ÷ e) complex ((b × c) - (a × d) $ ÷ e)
  )
}

graiþ a add, a multiply
fill (a complex) absolute a {
  let (a complex b) absolute = (a × a) + (b × b)
}

fill (float complex) elementary {
  let (a complex b) exponent = (
    let c = a exponent
    yield (c × (b cosine)) complex (c × (b sine))
  )
  let (a complex b) logariþm = ((a × a) + (b × b) $ logariþm) complex (a arctan-float b)
  let (a complex b) sine = (
    let positive = ((zero - b) complex a) exponent
    let negative = (b complex (zero - a)) exponent
    yield (((positive imaginary) - (negative imaginary)) × 0.5)
    complex (((negative real) - (positive real)) × 0.5)
  )
  let (a complex b) cosine = (
    let positive = ((zero - b) complex a) exponent
    let negative = (b complex (zero - a)) exponent
    yield (((positive real) + (negative real)) × 0.5)
    complex (((positive imaginary) + (negative imaginary)) × 0.5)
  )
}
