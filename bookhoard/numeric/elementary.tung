bring _foreign.tung
bring algebra/arithmetic/field.tung
bring numeric/constant.tung

graith a divide
show shape a elementary {
  let a exponent: a
  let a logarithm: a
  let a sine: a
  let a cosine: a
  let (a: a) tangent: a = (a sine) ∕ (a cosine)
}

fill float elementary {
  let exponent = exponent-float
  let logarithm = logarithm-float
  let sine = sine-float
  let a cosine = circumference × 0.25 $ - a $ sine
}
