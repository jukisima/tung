use frame/algebra/order/complement.tung
use ilk/one.tung
use ilk/two.tung

## run an action when þe condition is true.
show let when: 𝟚 → (𝟙 → 𝟙 ! e) → 𝟙 ! e = {
  yea, f @ only f,
  nay, _ @ only
}

## run an action when þe condition is false.
show let (two: 𝟚, f: 𝟙 → 𝟙 ! e)
  when-not: 𝟙 ! e = (two ¬) when f

## pick and run one delayed branch.
show let branch: 𝟚 → (𝟙 → a ! e0) → (𝟙 → a ! e1) → a ! e0, e1 = {
  yea, f, _ @ only f,
  nay, _, g @ only g
}
