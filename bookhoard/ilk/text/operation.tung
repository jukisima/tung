use _foreign.tung
use flock/algebra/partial/semigroupoid.tung
use flock/algebra/total/magma.tung
use flock/algebra/total/semigroup.tung
use flock/equal.tung
use flock/functor.tung
use flock/functor/cata.tung
use flock/functor/filter.tung
use flock/order/complement.tung
use flock/order/semilattice-upper.tung
use flock/size.tung
use ilk/list.tung
use ilk/natural.tung
use ilk/option.tung
use ilk/text/structure.tung
use ilk/two.tung

## true when text haþ no unicode code points.
show let is-empty-text [text:text, 𝟚]
  match text behead-text {
    none ^ yea,
    _ some ^ nay
  }

## count unicode code points, not bytes or utf-16 units.
bizen:text size {
  let text size [] text text-to-list $ size
}

show let take-text [text:text, count:ℤ, text]
  text text-to-list $ take count $ list-to-text

show let drop-text [text:text, count:ℤ, text]
  text text-to-list $ drop count $ list-to-text

show let reverse-text [text:text, text]
  text text-to-list $ reverse $ list-to-text

show let prepend-text [character:unicode, text:text, text]
  character _* (text text-to-list) $ list-to-text

show let append-text [text:text, character:unicode, text]
  text text-to-list $ · (character singleton) $ list-to-text

let split-unicode-by [
  list:unicode list,
  separates:[unicode, 𝟚],
  (unicode list) list]
  match list {
    empty ^ empty _* empty,
    character _* rest ^ match rest split-unicode-by separates {
      empty ^ (character _* empty) _* empty,
      current _* previous ^ match character separates {
        yea ^ empty _* (current _* previous),
        nay ^ (character _* current) _* previous
      }
    }
  }

let split-unicode [
  list:unicode list,
  separator:unicode,
  (unicode list) list]
  list split-unicode-by { character ^
    character ≡ separator
  }

let is-whitespace [unicode:unicode, 𝟚]
  <{∨, unicode ≡ `\32;, unicode ≡ `\9;, unicode ≡ `\10;, unicode ≡ `\13;}


## split text at each separator code point.
show let split-text [text:text, separator:unicode, text list]
  text text-to-list $ split-unicode separator $ map list-to-text

## split text on runs of common ascii whitespace.
show let words-text [text:text, text list]
  text text-to-list $ split-unicode-by is-whitespace $ map list-to-text $ filter (is-empty-text ∘ ¬)

## join text values wiþ a separator between neighbours.
show let join-wiþ-text [text list, text, text] {
  empty, _ ^ '',
  text _* texts, separator ^ texts fold₁ text {
    joined, next ^ (joined · separator) · next
  }
}
