use _foreign.tung
use ilk/one.tung

## a non-normalised span measured in milliseconds.
show ilk milliseconds {
  ℤ milliseconds
}

show let seconds [t:ℤ, milliseconds]
  t × 1000 $ milliseconds

show let minutes [t:ℤ, milliseconds]
  t × 60 $ seconds


show let hours [t:ℤ, milliseconds]
  t × 60 $ minutes

show let sleep-for [(t milliseconds):milliseconds, 𝟙; async]
  t sleep
