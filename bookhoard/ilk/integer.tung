use _foreign.tung
use flock/algebra/arithmetic/add.tung
use flock/algebra/arithmetic/monoid-additive.tung
use flock/algebra/arithmetic/monoid-multiplicative.tung
use flock/algebra/arithmetic/multiply.tung
use flock/algebra/arithmetic/one.tung
use flock/algebra/arithmetic/semiring.tung
use flock/algebra/arithmetic/subtract.tung
use flock/algebra/arithmetic/zero.tung
use flock/order/less-equal.tung
use ilk/natural.tung
use ilk/two.tung

## convert a nonnegative integer to a natural.
show let to-ℕ [integer:ℤ, ℕ; text fail]
  match 0 ≤ integer {
    yea ^ match integer {
      0 ^ natural~zero,
      n ^ (n - 1) to-ℕ $ suc
    },
    nay ^ 'negative cannot be a natural' fail
  }

bizen:ℤ add {
  let + [] add-integer
}

bizen:ℤ zero {
  let zero [] 0
}

bizen:ℤ multiply {
  let × [] multiply-integer
}

bizen:ℤ one {
  let one [] 1
}

bizen:ℤ monoid-additive {}

bizen:ℤ monoid-multiplicative {}

bizen:ℤ semiring {}
