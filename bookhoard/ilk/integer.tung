use _foreign.tung
use ilk/natural.tung
use ilk/two.tung
use order.tung
use order/lattice.tung

## convert a nonnegative integer to a natural.
show let (integer: ℤ) to-ℕ: ℕ ! text fail =
  match 0 ≤ integer {
    yea @ match integer {
      0 @ zero,
      n @ (n - 1) to-ℕ $ suc
    },
    nay @ 'negative cannot be a natural' fail
  }
