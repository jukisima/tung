use flock/algebra/total/magma.tung
use flock/algebra/total/monoid.tung
use flock/algebra/total/semigroup.tung
use flock/functor.tung
use flock/functor/applicative.tung
use flock/functor/cata.tung
use flock/functor/filter.tung
use flock/functor/monad.tung
use flock/functor/traverse.tung
use flock/order/complement.tung
use ilk/one.tung
use ilk/two.tung

## optional value.
show ilk option [a:ilk] {
  none [a option]
  some [a, a option]
}

graiþ a semigroup
bizen (a option) semigroup {
  let * ≔ {
    none,   b      ^ b,
    a,      none   ^ a,
    a some, b some ^ a * b $ some
  }
}

graiþ a semigroup
bizen (a option) monoid {
  let ∅ ≔ none
}

bizen option functor {
  let map ≔ {
    none,   _ ^ none,
    a some, f ^ a f $ some
  }
}

bizen option applicative {
  let pure ≔ some
  let apply ≔ {
    a some, f some ^ a f $ some,
    _,      _      ^ none
  }
}

bizen option monad {
  let flat ≔ {
    none   ^ none,
    a some ^ a
  }
}

bizen option filter {
  let filter ≔ {
    none, _   ^ none,
    a some, f ^ a f $ if (a some) none
  }
}

bizen option cata {
  let fold₀ ≔ {
    none,   b, _ ^ b,
    a some, b, f ^ a f b
  }
  let fold₁ ≔ {
    none,   b, _ ^ b,
    a some, b, f ^ b f a
  }
}

bizen option traverse {
  let traverse ≔ {
    none,   _ ^ none pure,
    a some, f ^ (a f) map some
  }
}

## extract an option wiþ a fallback value.
show let default [a option, a, a] {
  none,   b ^ b,
  a some, _ ^ a
}

## consume an option wiþ a fallback and a present-value branch.
show let maybe [a option, b, [a, b; e], b; e] {
  none,   b, _ ^ b,
  a some, _, f ^ a f
}

## true when an option containeþ a value.
show let is-some [a option, 𝟚] {
  none   ^ nay,
  _ some ^ yea
}

## true when an option is empty.
show let is-none [option:a option, 𝟚] option is-some $ ¬

## extract an option or run a fallback computation.
show let or-else [a option, [𝟙, a; e], a; e] {
  none, fallback ^ only fallback,
  a some, _ ^ a
}
