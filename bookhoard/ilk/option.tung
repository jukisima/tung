use frame/algebra/order/complement.tung
use frame/algebra/partial/semigroup.tung
use frame/algebra/total/magma.tung
use frame/algebra/total/monoid.tung
use frame/functor.tung
use frame/functor/applicative.tung
use frame/functor/cata.tung
use frame/functor/filter.tung
use frame/functor/monad.tung
use frame/functor/traverse.tung
use ilk/one.tung
use ilk/two.tung

## optional value.
show ilk a option {
  none,
  a some
}

graiþ a semigroup
fill (a option) semigroup {
  let * = {
    none, b @ b,
    a, none @ a,
    a some, b some @ a * b $ some
  }
}

graiþ a semigroup
fill (a option) monoid {
  let ∅ = none
}

fill option functor {
  let map = {
    none, _ @ none,
    a some, f @ a f $ some
  }
}

fill option applicative {
  let pure = some
  let apply = {
    a some, f some @ a f $ some,
    _, _ @ none
  }
}

fill option monad {
  let flat = {
    none @ none,
    a some @ a
  }
}

fill option filter {
  let filter = {
    none, _ @ none,
    a some, f @ a f $ if (a some) none
  }
}

fill option cata {
  let fold₀ = {
    none, b, _ @ b,
    a some, b, f @ a f b
  }
  let fold₁ = {
    none, b, _ @ b,
    a some, b, f @ b f a
  }
}

fill option traverse {
  let traverse = {
    none, _ @ none pure,
    a some, f @ (a f) map some
  }
}

## extract an option wiþ a fallback value.
show let default: a option → a → a = {
  none, b @ b,
  a some, _ @ a
}

## consume an option wiþ a fallback and a present-value branch.
show let maybe: a option → b → (a → b ! e) → b ! e = {
  none, b, _ @ b,
  a some, _, f @ a f
}

## true when an option containeþ a value.
show let is-some: a option → 𝟚 = {
  none @ nay,
  _ some @ yea
}

## true when an option is empty.
show let (option: a option) is-none: 𝟚 = option is-some $ ¬

## extract an option or run a fallback computation.
show let (option: a option, fallback: 𝟙 → a ! e) or-else: a ! e =
  match option {
    none @ only fallback,
    a some @ a
  }
