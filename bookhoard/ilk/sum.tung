use flock/algebra/partial/category.tung
use flock/functor.tung
use flock/functor/applicative.tung
use flock/functor/bifunctor.tung
use flock/functor/cata.tung
use flock/functor/monad.tung
use flock/functor/traverse.tung
use flock/order/complement.tung
use ilk/two.tung

show ilk ∐ [a:ilk, b:ilk] {
  inject₀ [a, a ∐ b]
  inject₁ [b, a ∐ b]
}

show let eiþer [
  sum:a ∐ b,
  f₀:[a, c; e₀],
  f₁:[b, c; e₁],
  c; e₀, e₁]
  match sum {
    a inject₀ ^ a f₀,
    b inject₁ ^ b f₁
  }

bizen ∐ bifunctor {
  let sum bimap f g ≔ match sum {
    a inject₀ ^ (a f) inject₀,
    b inject₁ ^ (b g) inject₁
  }
}

show let is-inject₀ [a ∐ b, 𝟚] {
  _ inject₀ ^ yea,
  _ inject₁ ^ nay
}

show let is-inject₁ [sum:a ∐ b, 𝟚] sum is-inject₀ $ ¬

bizen (a ∐) functor {
  let sum map f ≔ sum bimap sameness f
}

bizen (a ∐) applicative {
  let pure ≔ inject₁
  let apply ≔ {
    a inject₀, _ ^ a inject₀,
    _, a inject₀ ^ a inject₀,
    b inject₁, f inject₁ ^ (b f) inject₁
  }
}

bizen (a ∐) monad {
  let flat ≔ {
    a inject₀ ^ a inject₀,
    b inject₁ ^ b
  }
}

bizen (a ∐) cata {
  let sum fold₀ b f ≔ match sum {
    _ inject₀ ^ b,
    a inject₁ ^ a f b
  }
  let sum fold₁ b f ≔ match sum {
    _ inject₀ ^ b,
    a inject₁ ^ b f a
  }
}

bizen (a ∐) traverse {
  let sum traverse f ≔ match sum {
    a inject₀ ^ (a inject₀) pure,
    b inject₁ ^ (b f) map inject₁
  }
}
