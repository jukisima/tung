use frame/algebra/arithmetic/add.tung
use frame/algebra/arithmetic/monoid-additive.tung
use frame/algebra/arithmetic/monoid-multiplicative.tung
use frame/algebra/arithmetic/multiply.tung
use frame/algebra/arithmetic/one.tung
use frame/algebra/arithmetic/semiring.tung
use frame/algebra/arithmetic/zero.tung
use frame/algebra/order/less-equal.tung
use frame/algebra/order/order-partial.tung
use frame/algebra/order/order-total.tung
use frame/algebra/order/semilattice-supremal-bounded.tung
use frame/equal.tung
use ilk/two.tung

show ilk ℕ {
  zero,
  ℕ suc
}

fill ℕ equal {
  let ≡ = {
    zero, zero @ yea,
    a suc, b suc @ a ≡ b,
    _, _ @ nay
  }
}

fill ℕ less-equal {
  let ≤ = {
    zero, _ @ yea,
    _, zero @ nay,
    a suc, b suc @ a ≤ b
  }
}

fill ℕ order-partial {}

fill ℕ order-total {}

fill ℕ semilattice-supremal-bounded {
  let ⟂ = zero
}

fill ℕ semiring {
  let + = {
    a, zero @ a,
    a, b suc @ (a + b) suc
  }

  let zero = zero

  let × = {
    _, zero @ zero,
    a, b suc @ a + (a × b)
  }

  let one = zero suc
}

show let to-ℤ: ℕ → ℤ = {
  zero @ 0,
  a suc @ 1 + (a to-ℤ)
}
