use flock/algebra/arithmetic/add.tung
use flock/algebra/arithmetic/monoid-additive.tung
use flock/algebra/arithmetic/monoid-multiplicative.tung
use flock/algebra/arithmetic/multiply.tung
use flock/algebra/arithmetic/one.tung
use flock/algebra/arithmetic/semiring.tung
use flock/algebra/arithmetic/zero.tung
use flock/equal.tung
use flock/order/less-equal.tung
use flock/order/order-partial.tung
use flock/order/order-total.tung
use flock/order/semilattice-upper-bounded.tung
use ilk/two.tung

show ilk ℕ {
  zero [ℕ]
  suc [ℕ, ℕ]
}

bizen ℕ equal {
  let ≡ ≔ {
    zero, zero ^ yea,
    a suc, b suc ^ a ≡ b,
    _, _ ^ nay
  }
}

bizen ℕ less-equal {
  let ≤ ≔ {
    zero, _ ^ yea,
    _, zero ^ nay,
    a suc, b suc ^ a ≤ b
  }
}

bizen ℕ order-partial {}

bizen ℕ order-total {}

bizen ℕ semilattice-upper-bounded {
  let ⟂ ≔ zero
}

bizen ℕ semiring {
  let + ≔ {
    a, zero ^ a,
    a, b suc ^ (a + b) suc
  }

  let zero ≔ zero

  let × ≔ {
    _, zero ^ zero,
    a, b suc ^ a + (a × b)
  }

  let one ≔ zero suc
}

show let to-ℤ [ℕ, ℤ] {
  zero  ^ 0,
  a suc ^ 1 + (a to-ℤ)
}
