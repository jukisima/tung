use ilk/two.tung
use equal.tung
use order.tung
use order/lattice.tung
use algebra/arithmetic/semiring.tung

show ilk ℕ {
  zero,
  ℕ suc
}

fill ℕ equal {
  let ≡ = {
    zero, zero @ yea,
    a suc, b suc @ a ≡ b,
    _, _ @ nay
  }
}

fill ℕ less-equal {
  let ≤ = {
    zero, _ @ yea,
    _, zero @ nay,
    a suc, b suc @ a ≤ b
  }
}

fill ℕ order-partial {}

fill ℕ order-total {}

fill ℕ semilattice-supremal-bounded {
  let ⟂ = zero
}

fill ℕ semiring {
  let + = {
    a, zero @ a,
    a, b suc @ (a + b) suc
  }

  let zero = zero

  let × = {
    _, zero @ zero,
    a, b suc @ a + (a × b)
  }

  let one = zero suc
}

show let to-ℤ: ℕ → ℤ = {
  zero @ 0,
  a suc @ 1 + (a to-ℤ)
}
