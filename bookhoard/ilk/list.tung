use frame/algebra/arithmetic/add.tung
use frame/algebra/partial/semigroup.tung
use frame/algebra/total/magma.tung
use frame/algebra/total/monoid.tung
use frame/equal.tung
use frame/functor.tung
use frame/functor/applicative.tung
use frame/functor/cata.tung
use frame/functor/filter.tung
use frame/functor/monad.tung
use frame/functor/traverse.tung
use frame/inhold.tung
use frame/size.tung
use ilk/natural.tung
use ilk/one.tung
use ilk/option.tung
use ilk/product.tung
use ilk/two.tung

deed e fail {
  e fail: a
}

## finite linked lists.
show ilk a list {
  empty,
  a _* (a list)
}

graiþ a equal
fill (a list) inhold a {
  let ∋ = {
    empty, _ @ nay,
    first _* rest, a @ (a ≡ first) if yea (rest ∋ a)
  }
}

## integer range from start to stop, inclusive.
show let (start: ℤ, stop: ℤ) till: ℤ list =
  match start ≤ stop {
    yea @ start _* (start + 1 $ till stop),
    nay @ empty
  }

## build a one-element list.
show let (a: a) singleton: a list = a _* empty

fill (a list) semigroup {
  let * = {
    empty, list @ list,
    first _* rest, list @ first _* (rest * list)
  }
}

fill (a list) monoid {
  let ∅ = empty
}

fill list functor {
  let map = {
    empty, _ @ empty,
    first _* rest, f @ (first f) _* (rest map f)
  }
}

fill list monad {
  let a pure = a _* empty
  let list apply = {
    empty @ empty,
    first _* rest @ (list map first) * (list apply rest)
  }
  let flat = {
    empty @ empty,
    first _* rest @ first * (rest flat)
  }
}

fill list filter {
  let filter = {
    empty, _ @ empty,
    first _* rest, f @ match first f {
      yea @ first _* (rest filter f),
      nay @ rest filter f
    }
  }
}

show let each: a list → (a → 𝟙 ! e) → 𝟙 ! e = {
  list, action @ list fold₁ only { _, a @ a action }
}

## first list element, if present.
show let head: a list → a option = {
  empty @ none,
  first _* _ @ first some
}

## list wiþout its first element, if present.
show let tail: a list → (a list) option = {
  empty @ none,
  _ _* rest @ rest some
}

show let behead: a list → (a ∏ (a list)) option = {
  empty @ none,
  first _* rest @ (first ∏ rest) some
}

## first count elements.
show let (list: a list, count: ℤ) take: a list =
  match count ≤ 0 {
    yea @ empty,
    nay @ match list {
      empty @ empty,
      first _* rest @ first _* (rest take (count - 1))
    }
  }

## list after removing count elements.
show let (list: a list, count: ℤ) drop: a list =
  match count ≤ 0 {
    yea @ list,
    nay @ match list {
      empty @ empty,
      _ _* rest @ rest drop (count - 1)
    }
  }

## first element accepted by a predicate.
show let find: a list → (a → 𝟚 ! e) → a option ! e = {
  empty, _ @ none,
  first _* rest, f @ match first f {
    yea @ first some,
    nay @ rest find f
  }
}

fill list cata {
  let list fold₀ b f = match list {
    empty @ b,
    first _* rest @ first f (rest fold₀ b f)
  }
  let list fold₁ b f = match list {
    empty @ b,
    first _* rest @ rest fold₁ (b f first) f
  }
}

fill list traverse {
  let traverse = {
    empty, _ @ empty pure,
    first _* rest, f @ (first f) lift₂ (rest traverse f) _*
  }
}

fill (a list) size {
  let list size = list fold₁ natural~zero { n, _ @ n suc }
}

show let (list: a list) reverse: a list =
  list fold₁ empty { outcome, a @ a _* outcome }

show let zip: a list → b list → (a ∏ b) list = {
  empty, _ | _, empty @ empty,
  a _* a…, b _* b… @ (a ∏ b) _* (a… zip b…)
}

## element at a zero-based index.
show let (list: a list, index: ℤ) at: a ! text fail = match index ≤ -1 {
  yea @ 'list index out of range' fail,
  nay @ match list drop index {
    empty @ 'list index out of range' fail,
    first _* _ @ first
  }
}

## final element, if present.
show let (list: a list) last: a option =
  list fold₁ none { _, a @ a some }

## repeat a value count times.
show let (a: a, count: ℤ) replicate: a list =
  match count ≤ 0 {
    yea @ empty,
    nay @ a _* (a replicate (count - 1))
  }

## split values accepted and rejected by a predicate.
show let partition: a list → (a → 𝟚 ! e) → (a list) ∏ (a list) ! e = {
  list, f @ list fold₀ (empty ∏ empty) { a, accepted ∏ rejected @
    (a f) if ((a _* accepted) ∏ rejected) (accepted ∏ (a _* rejected))
  }
}

## split a list of products into two lists.
show let (pairs: (a ∏ b) list) unzip: (a list) ∏ (b list) =
  pairs fold₀ (empty ∏ empty) { a ∏ b, a… ∏ b… @
    (a _* a…) ∏ (b _* b…)
  }
