use ilk/one.tung
use ilk/two.tung
use algebra/partial/category.tung
use equal.tung
use order.tung
use ilk/product.tung
use algebra/total/magma.tung
use algebra/total/semigroup.tung
use algebra/total/monoid.tung
use algebra/arithmetic/semiring.tung
use ilk/natural.tung
use ilk/option.tung
use collection/size.tung
use collection/catamorphism.tung
use collection/functor.tung
use collection/applicative.tung
use collection/monad.tung
use collection/filter.tung
use collection/inhold.tung
use collection/traverse.tung

## finite linked lists.
show ilk a list {
  empty,
  a _* (a list)
}

graiþ a equal
fill (a list) inhold a {
  let ∋ = {
    empty, _ @ nay,
    first _* rest, a @ (a ≡ first) if yea (rest ∋ a)
  }
}

## integer range from start to stop, inclusive.
show let (start: integer, stop: integer) till: integer list = match start ≤ stop {
  yea @ start _* (start + 1 $ till stop),
  nay @ empty
}

## build a one-element list.
show let (a: a) singleton: a list = a _* empty

fill (a list) semigroup {
  let * = {
    empty, list @ list,
    first _* rest, list @ first _* (rest * list)
  }
}

fill (a list) monoid {
  let ∅ = empty
}

fill list functor {
  let map = {
    empty, _ @ empty,
    first _* rest, f @ (first f) _* (rest map f)
  }
}

fill list monad {
  let a pure = a _* empty
  let list apply = {
    empty @ empty,
    first _* rest @ (list map first) * (list apply rest)
  }
  let flat = {
    empty @ empty,
    first _* rest @ first * (rest flat)
  }
}

fill list filter {
  let filter = {
    empty, _ @ empty,
    first _* rest, f @ match first f {
      yea @ first _* (rest filter f),
      nay @ rest filter f
    }
  }
}

show let each: a list → (a → 𝟙 ! e) → 𝟙 ! e = {
  empty, _ @ only,
  first _* rest, action @ (
    let _ = first action
    yield rest each action
  )
}

## first list element, if present.
show let head: a list → a option = {
  empty @ none,
  first _* _ @ first some
}

## list wiþout its first element, if present.
show let tail: a list → (a list) option = {
  empty @ none,
  _ _* rest @ rest some
}

show let behead: a list → (a ∏ (a list)) option = {
  empty @ none,
  first _* rest @ (first ∏ rest) some
}

## first count elements.
show let (list: a list, count: integer) take: a list =
  match count ≤ 0 {
    yea @ empty,
    nay @ match list {
      empty @ empty,
      first _* rest @ first _* (rest take (count - 1))
    }
  }

## list after removing count elements.
show let (list: a list, count: integer) drop: a list =
  match count ≤ 0 {
    yea @ list,
    nay @ match list {
      empty @ empty,
      _ _* rest @ rest drop (count - 1)
    }
  }

## first element accepted by a predicate.
show let find: a list → (a → 𝟚 ! e) → a option ! e = {
  empty, _ @ none,
  first _* rest, f @ match first f {
    yea @ first some,
    nay @ rest find f
  }
}

fill list cata {
  let list fold₀ b f = match list {
    empty @ b,
    first _* rest @ first f (rest fold₀ b f)
  }
  let list fold₁ b f = match list {
    empty @ b,
    first _* rest @ rest fold₁ (b f first) f
  }
}

fill list traverse {
  let traverse = {
    empty, _ @ empty pure,
    first _* rest, f @ (first f) lift₂ (rest traverse f) _*
  }
}

fill (a list) size {
  let list size = list fold₁ natural.zero { n, _ @ n suc }
}

show let (list: a list) reverse: a list =
  list fold₁ empty { outcome, a @ a _* outcome }

show let zip: a list → b list → (a ∏ b) list = {
  empty, _ | _, empty @ empty,
  a _* a…, b _* b… @ (a ∏ b) _* (a… zip b…)
}

## element at a zero-based index.
show let (list: a list, index: integer) at: a option = match index ≤ -1 {
  yea @ none,
  nay @ (list drop index) head
}

## final element, if present.
show let (list: a list) last: a option =
  (list reverse) head

## repeat a value count times.
show let (a: a, count: integer) replicate: a list =
  match count ≤ 0 {
    yea @ empty,
    nay @ a _* (a replicate (count - 1))
  }

## split values accepted and rejected by a predicate.
show let partition: a list → (a → 𝟚 ! e) → (a list) ∏ (a list) ! e = {
  empty, _ @ empty ∏ empty,
  first _* rest, f @ match rest partition f {
    accepted ∏ rejected @ match first f {
      yea @ (first _* accepted) ∏ rejected,
      nay @ accepted ∏ (first _* rejected)
    }
  }
}

## split a list of products into two lists.
show let unzip: (a ∏ b) list → (a list) ∏ (b list) = {
  empty @ empty ∏ empty,
  (a ∏ b) _* pairs @ match pairs unzip {
    a… ∏ b… @ (a _* a…) ∏ (b _* b…)
  }
}
