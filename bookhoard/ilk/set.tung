use frame/algebra/order/complement.tung
use frame/algebra/order/lattice-distributive.tung
use frame/algebra/order/lattice.tung
use frame/algebra/order/less-equal.tung
use frame/algebra/order/order-partial.tung
use frame/algebra/order/semilattice-infimal.tung
use frame/algebra/order/semilattice-supremal-bounded.tung
use frame/algebra/order/semilattice-supremal.tung
use frame/algebra/partial/semigroup.tung
use frame/algebra/total/monoid.tung
use frame/equal.tung
use frame/functor/cata.tung
use frame/functor/filter.tung
use frame/inhold.tung
use frame/size.tung
use ilk/list.tung
use ilk/powerset.tung
use ilk/two.tung

## a list-backed finite set.
show ilk a set {
  (a list) from-list
}

show let empty: a set = list~empty from-list

show let (a: a) singleton: a set =
  (a _* list~empty) from-list

show let (list from-list: a set) to-list: a list = list

graiþ (a list) inhold a
fill (a set) inhold a {
  let (list from-list) ∋ a = list ∋ a
}

graiþ (a list) inhold a
show let (list from-list: a set, a: a) put: a set =
  (list ∋ a) if (list from-list) ((a _* list) from-list)

show let (list from-list: a set, predicate: a → 𝟚 ! e) keep: a set ! e =
  (list filter predicate) from-list

graiþ a equal
show let (set: a set, a: a) rid: a set =
  set keep { b @ a ≢ b }

graiþ (a set) inhold a
show let (set₀: a set, set₁: a set) ∖: a set =
  set₀ keep { value @ (set₁ ∋ value) ¬ }

graiþ (a list) inhold a
show let (list from-list: a set) to-powerset: a powerset = list ∋

fill (a set) size {
  let (list from-list) size = list size
}

graiþ (a list) inhold a
let (list₀: a list, list₁: a list) included: 𝟚 =
  list₀ fold₀ yea { value, all-included @
    all-included ∧ (list₁ ∋ value)
  }

graiþ (a list) inhold a
fill (a set) equal {
  let (list₀ from-list) ≡ (list₁ from-list) =
    (list₀ included list₁) ∧ (list₁ included list₀)
}

graiþ (a list) inhold a
fill (a set) less-equal {
  let (list₀ from-list) ≤ (list₁ from-list) = list₀ included list₁
}

graiþ (a list) inhold a
fill (a set) order-partial {}

graiþ (a list) inhold a
fill (a set) semigroup {
  let * = ∨
}

graiþ (a list) inhold a
fill (a set) monoid {
  let ∅ = empty
}

graiþ (a set) inhold a
fill (a set) semilattice-infimal {
  let set₀ ∧ set₁ = set₀ keep { value @ set₁ ∋ value }
}

graiþ (a list) inhold a
fill (a set) semilattice-supremal {
  let (list₀ from-list) ∨ (list₁ from-list) =
    list₁ fold₁ (list₀ from-list) put
}

graiþ (a list) inhold a
fill (a set) lattice {}

graiþ (a list) inhold a
fill (a set) lattice-distributive {}

graiþ (a list) inhold a
fill (a set) semilattice-supremal-bounded {
  let ⟂ = empty
}
