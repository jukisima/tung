use flock/algebra/total/monoid.tung
use flock/algebra/total/semigroup.tung
use flock/equal.tung
use flock/functor/cata.tung
use flock/functor/filter.tung
use flock/inhold.tung
use flock/order/complement.tung
use flock/order/lattice-distributive.tung
use flock/order/lattice.tung
use flock/order/less-equal.tung
use flock/order/order-partial.tung
use flock/order/semilattice-lower.tung
use flock/order/semilattice-upper-bounded.tung
use flock/order/semilattice-upper.tung
use flock/size.tung
use ilk/list.tung
use ilk/powerset.tung
use ilk/two.tung

## a list-backed finite set.
show ilk set [a:ilk] {
  from-list [a list, a set]
}

show let empty [a set] list~empty from-list

show let singleton [a:a, a set]
  (a _* list~empty) from-list

show let to-list [list from-list:a set, a list] list

graiþ (a list) inhold a
bizen (a set) inhold a {
  let (list from-list) ∋ a ≔ list ∋ a
}

graiþ (a list) inhold a
show let put [list from-list:a set, a:a, a set]
  (list ∋ a) if (list from-list) ((a _* list) from-list)

show let keep [
  list from-list:a set,
  predicate:[a, 𝟚; e],
  a set; e]
  (list filter predicate) from-list

graiþ a equal
show let rid [set:a set, a:a, a set]
  set keep { b ^ a ≢ b }

graiþ (a set) inhold a
show let ∖ [set₀:a set, set₁:a set, a set]
  set₀ keep { value ^ (set₁ ∋ value) ¬ }

graiþ (a list) inhold a
show let to-powerset [list from-list:a set, a powerset] list ∋

bizen (a set) size {
  let (list from-list) size ≔ list size
}

graiþ (a list) inhold a
let included [list₀:a list, list₁:a list, 𝟚]
  list₀ fold₀ yea { value, all-included ^
    all-included ∧ (list₁ ∋ value)
  }

graiþ (a list) inhold a
bizen (a set) equal {
  let (list₀ from-list) ≡ (list₁ from-list) ≔
    (list₀ included list₁) ∧ (list₁ included list₀)
}

graiþ (a list) inhold a
bizen (a set) less-equal {
  let (list₀ from-list) ≤ (list₁ from-list) ≔ list₀ included list₁
}

graiþ (a list) inhold a
bizen (a set) order-partial {}

graiþ (a list) inhold a
bizen (a set) semigroup {
  let * ≔ ∨
}

graiþ (a list) inhold a
bizen (a set) monoid {
  let ∅ ≔ empty
}

graiþ (a set) inhold a
bizen (a set) semilattice-lower {
  let set₀ ∧ set₁ ≔ set₀ keep { value ^ set₁ ∋ value }
}

graiþ (a list) inhold a
bizen (a set) semilattice-upper {
  let (list₀ from-list) ∨ (list₁ from-list) ≔
    list₁ fold₁ (list₀ from-list) put
}

graiþ (a list) inhold a
bizen (a set) lattice {}

graiþ (a list) inhold a
bizen (a set) lattice-distributive {}

graiþ (a list) inhold a
bizen (a set) semilattice-upper-bounded {
  let ⟂ ≔ empty
}
