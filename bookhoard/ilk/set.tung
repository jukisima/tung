use flock/algebra/total/monoid.tung
use flock/algebra/total/semigroup.tung
use flock/equal.tung
use flock/functor/cata.tung
use flock/functor/filter.tung
use flock/inhold.tung
use flock/order/complement.tung
use flock/order/lattice-distributive.tung
use flock/order/lattice.tung
use flock/order/less-equal.tung
use flock/order/order-partial.tung
use flock/order/semilattice-lower.tung
use flock/order/semilattice-upper-bounded.tung
use flock/order/semilattice-upper.tung
use flock/size.tung
use ilk/list.tung
use ilk/powerset.tung
use ilk/two.tung

## a list-backed finite set.
show ilk set [a:*, *] {
  from-list [a list, a set]
}

show let empty [@a:*, a set] list~empty from-list

show let singleton [@a:*, a:a, a set]
  (a _* list~empty) from-list

show let to-list [@a:*, list from-list:a set, a list] list

bizen [byzen (a list) inhold a]:(a set) inhold a {
  let (list from-list) ∋ a [] list ∋ a
}

show let put [byzen (a list) inhold a, list from-list:a set, a:a, a set]
  (list ∋ a) if (list from-list) ((a _* list) from-list)

show let keep [
  @a:*, @e:*,
  list from-list:a set,
  predicate:[a, 𝟚; e],
  a set; e]
  (list filter predicate) from-list

show let rid [byzen a equal, set:a set, a:a, a set]
  set keep { b ^ a ≢ b }

show let ∖ [byzen (a set) inhold a, set₀:a set, set₁:a set, a set]
  set₀ keep { value ^ (set₁ ∋ value) ¬ }

show let to-powerset [byzen (a list) inhold a, list from-list:a set, a powerset] list ∋

bizen [@a:*]:(a set) size {
  let (list from-list) size [] list size
}

let included [byzen (a list) inhold a, list₀:a list, list₁:a list, 𝟚]
  list₀ fold₀ yea { value, all-included ^
    all-included ∧ (list₁ ∋ value)
  }

bizen [byzen (a list) inhold a]:(a set) equal {
  let (list₀ from-list) ≡ (list₁ from-list) []
    (list₀ included list₁) ∧ (list₁ included list₀)
}

bizen [byzen (a list) inhold a]:(a set) less-equal {
  let (list₀ from-list) ≤ (list₁ from-list) [] list₀ included list₁
}

bizen [byzen (a list) inhold a]:(a set) order-partial {}

bizen [byzen (a list) inhold a]:(a set) semigroup {
  let · [] ∨
}

bizen [byzen (a list) inhold a]:(a set) monoid {
  let ∅ [] empty
}

bizen [byzen (a set) inhold a]:(a set) semilattice-lower {
  let set₀ ∧ set₁ [] set₀ keep { value ^ set₁ ∋ value }
}

bizen [byzen (a list) inhold a]:(a set) semilattice-upper {
  let (list₀ from-list) ∨ (list₁ from-list) []
    list₁ fold₁ (list₀ from-list) put
}

bizen [byzen (a list) inhold a]:(a set) lattice {}

bizen [byzen (a list) inhold a]:(a set) lattice-distributive {}

bizen [byzen (a list) inhold a]:(a set) semilattice-upper-bounded {
  let ⟂ [] empty
}
