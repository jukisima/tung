use combinator.tung
use flock/algebra/partial/semigroupoid.tung
use flock/equal.tung
use flock/inhold.tung
use flock/order/complement.tung
use flock/order/semilattice-lower.tung
use flock/order/semilattice-upper.tung
use ilk/two.tung

## a powerset represented by its membership predicate.
show let-ilk a powerset = a → 𝟚

show let empty [a powerset] nay constant

show let universe [a powerset] yea constant

graiþ a equal
show let singleton [a, a powerset] ≡

bizen (a powerset) inhold a {
  let powerset ∋ a ≔ a powerset
}

graiþ a equal
show let put [powerset:a powerset, a:a, a powerset]
  powerset ∨ (a singleton)

graiþ a equal
show let rid [powerset:a powerset, a:a, a powerset]
  powerset ∧ (a singleton $ ¬)

show let ∖ [powerset₀:a powerset, powerset₁:a powerset, a powerset] powerset₀ ∧ (powerset₁ ¬)

bizen (a powerset) complement {
  let powerset ¬ ≔ powerset ∘ ¬
}
