use combinator.tung
use flock/algebra/partial/semigroupoid.tung
use flock/equal.tung
use flock/inhold.tung
use flock/order/complement.tung
use flock/order/semilattice-lower.tung
use flock/order/semilattice-upper.tung
use ilk/two.tung

## a powerset represented by its membership predicate.
show let powerset [a:*, *] [a, 𝟚]

show let empty [@a:*, a powerset] nay constant

show let universe [@a:*, a powerset] yea constant

show let singleton [byzen a equal, a, a powerset] ≡

bizen [@a:*]:(a powerset) inhold a {
  let powerset ∋ a [] a powerset
}

show let put [byzen a equal, powerset:a powerset, a:a, a powerset]
  powerset ∨ (a singleton)

show let rid [byzen a equal, powerset:a powerset, a:a, a powerset]
  powerset ∧ (a singleton $ ¬)

show let ∖ [@a:*, powerset₀:a powerset, powerset₁:a powerset, a powerset] powerset₀ ∧ (powerset₁ ¬)

bizen [@a:*]:(a powerset) complement {
  let powerset ¬ [] powerset ∘ ¬
}
