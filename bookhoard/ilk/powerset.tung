use combinator.tung
use frame/algebra/order/complement.tung
use frame/algebra/order/semilattice-infimal.tung
use frame/algebra/order/semilattice-supremal.tung
use frame/algebra/partial/semigroupoid.tung
use frame/equal.tung
use frame/inhold.tung
use ilk/two.tung

## a powerset represented by its membership predicate.
show let-ilk a powerset = a func 𝟚

show let empty: a powerset = nay constant

show let universe: a powerset = yea constant

graiþ a equal
show let singleton: a → a powerset = ≡

fill (a powerset) inhold a {
  let powerset ∋ a = a powerset
}

graiþ a equal
show let (powerset: a powerset, a: a) put: a powerset =
  powerset ∨ (a singleton)

graiþ a equal
show let (powerset: a powerset, a: a) rid: a powerset =
  powerset ∧ (a singleton $ ¬)

show let (powerset₀: a powerset, powerset₁: a powerset)
  ∖: a powerset = powerset₀ ∧ (powerset₁ ¬)

fill (a powerset) complement {
  let powerset ¬ = powerset ∘ ¬
}
