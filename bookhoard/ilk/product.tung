use frame/algebra/order/lattice-distributive.tung
use frame/algebra/order/lattice.tung
use frame/algebra/order/semilattice-infimal.tung
use frame/algebra/order/semilattice-supremal.tung
use frame/algebra/partial/category.tung
use frame/algebra/partial/semigroup.tung
use frame/algebra/total/magma.tung
use frame/algebra/total/monoid.tung
use frame/functor.tung
use frame/functor/applicative.tung
use frame/functor/bifunctor.tung
use frame/functor/cata.tung
use frame/functor/monad.tung
use frame/functor/traverse.tung

show ilk a ∏ b {
  a ∏ b
}

show let (a ∏ _: a ∏ b) project₀: a = a

show let (a ∏ b: a ∏ b) project₁: b = b

show let (a ∏ b: a ∏ b) swap: b ∏ a = b ∏ a

fill ∏ bifunctor {
  let (a ∏ b) bimap f g = (a f) ∏ (b g)
}

fill (a ∏) functor {
  let þing map f = þing bimap sameness f
}

graiþ a monoid
fill (a ∏) applicative {
  let b pure = ∅ ∏ b
  let (a0 ∏ b) apply (a1 ∏ f) = (a0 * a1) ∏ (b f)
}

graiþ a monoid
fill (a ∏) monad {
  let (a ∏ (b ∏ c)) flat =
    (a * b) ∏ c
}

fill (a ∏) cata {
  let (_ ∏ a) fold₀ b f = a f b
  let (_ ∏ a) fold₁ b f = b f a
}

fill (a ∏) traverse {
  let (a ∏ b) traverse f =
    (b f) map (a ∏)
}

graiþ a semilattice-infimal, b semilattice-infimal
fill (a ∏ b) semilattice-infimal {
  let (a₀ ∏ b₀) ∧ (a₁ ∏ b₁) = (a₀ ∧ a₁) ∏ (b₀ ∧ b₁)
}

graiþ a semilattice-supremal, b semilattice-supremal
fill (a ∏ b) semilattice-supremal {
  let (a₀ ∏ b₀) ∨ (a₁ ∏ b₁) = (a₀ ∨ a₁) ∏ (b₀ ∨ b₁)
}

graiþ a lattice, b lattice
fill (a ∏ b) lattice {}

graiþ a lattice-distributive, b lattice-distributive
fill (a ∏ b) lattice-distributive {}
