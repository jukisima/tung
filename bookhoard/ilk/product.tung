use flock/algebra/partial/category.tung
use flock/algebra/total/magma.tung
use flock/algebra/total/monoid.tung
use flock/algebra/total/semigroup.tung
use flock/functor.tung
use flock/functor/applicative.tung
use flock/functor/bifunctor.tung
use flock/functor/cata.tung
use flock/functor/monad.tung
use flock/functor/traverse.tung
use flock/order/lattice-distributive.tung
use flock/order/lattice.tung
use flock/order/semilattice-lower.tung
use flock/order/semilattice-upper.tung

show ilk ∏ [a:ilk, b:ilk] {
  ∏ [a, b, a ∏ b]
}

show let project₀ [a ∏ _:a ∏ b, a] a

show let project₁ [a ∏ b:a ∏ b, b] b

show let swap [a ∏ b:a ∏ b, b ∏ a] b ∏ a

bizen ∏ bifunctor {
  let (a ∏ b) bimap f g ≔ (a f) ∏ (b g)
}

bizen (a ∏) functor {
  let þing map f ≔ þing bimap sameness f
}

graiþ a monoid
bizen (a ∏) applicative {
  let b pure ≔ ∅ ∏ b
  let (a0 ∏ b) apply (a1 ∏ f) ≔ (a0 * a1) ∏ (b f)
}

graiþ a monoid
bizen (a ∏) monad {
  let (a ∏ (b ∏ c)) flat ≔
    (a * b) ∏ c
}

bizen (a ∏) cata {
  let (_ ∏ a) fold₀ b f ≔ a f b
  let (_ ∏ a) fold₁ b f ≔ b f a
}

bizen (a ∏) traverse {
  let (a ∏ b) traverse f ≔
    (b f) map (a ∏)
}

graiþ a semilattice-lower, b semilattice-lower
bizen (a ∏ b) semilattice-lower {
  let (a₀ ∏ b₀) ∧ (a₁ ∏ b₁) ≔ (a₀ ∧ a₁) ∏ (b₀ ∧ b₁)
}

graiþ a semilattice-upper, b semilattice-upper
bizen (a ∏ b) semilattice-upper {
  let (a₀ ∏ b₀) ∨ (a₁ ∏ b₁) ≔ (a₀ ∨ a₁) ∏ (b₀ ∨ b₁)
}

graiþ a lattice, b lattice
bizen (a ∏ b) lattice {}

graiþ a lattice-distributive, b lattice-distributive
bizen (a ∏ b) lattice-distributive {}

show let uncurry [a ∏ b:a ∏ b, f:[a, b, c], c]
  a f b

show let uncurry₃ [
  a ∏ (b ∏ c):a ∏ (b ∏ c),
  f:[a, b, c, d], d]
  a f b c
