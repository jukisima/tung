use frame/algebra/partial/category.tung
use frame/algebra/total/magma.tung
use frame/algebra/total/monoid.tung
use frame/algebra/total/semigroup.tung
use frame/functor.tung
use frame/functor/applicative.tung
use frame/functor/bifunctor.tung
use frame/functor/cata.tung
use frame/functor/monad.tung
use frame/functor/traverse.tung
use frame/order/lattice-distributive.tung
use frame/order/lattice.tung
use frame/order/semilattice-lower.tung
use frame/order/semilattice-upper.tung

show ilk a ∏ b {
  a ∏ b
}

show let project₀ [a ∏ _:a ∏ b, a] a

show let project₁ [a ∏ b:a ∏ b, b] b

show let swap [a ∏ b:a ∏ b, b ∏ a] b ∏ a

fill ∏ bifunctor {
  let (a ∏ b) bimap f g = (a f) ∏ (b g)
}

fill (a ∏) functor {
  let þing map f = þing bimap sameness f
}

graiþ a monoid
fill (a ∏) applicative {
  let b pure = ∅ ∏ b
  let (a0 ∏ b) apply (a1 ∏ f) = (a0 * a1) ∏ (b f)
}

graiþ a monoid
fill (a ∏) monad {
  let (a ∏ (b ∏ c)) flat =
    (a * b) ∏ c
}

fill (a ∏) cata {
  let (_ ∏ a) fold₀ b f = a f b
  let (_ ∏ a) fold₁ b f = b f a
}

fill (a ∏) traverse {
  let (a ∏ b) traverse f =
    (b f) map (a ∏)
}

graiþ a semilattice-lower, b semilattice-lower
fill (a ∏ b) semilattice-lower {
  let (a₀ ∏ b₀) ∧ (a₁ ∏ b₁) = (a₀ ∧ a₁) ∏ (b₀ ∧ b₁)
}

graiþ a semilattice-upper, b semilattice-upper
fill (a ∏ b) semilattice-upper {
  let (a₀ ∏ b₀) ∨ (a₁ ∏ b₁) = (a₀ ∨ a₁) ∏ (b₀ ∨ b₁)
}

graiþ a lattice, b lattice
fill (a ∏ b) lattice {}

graiþ a lattice-distributive, b lattice-distributive
fill (a ∏ b) lattice-distributive {}

show let uncurry [a ∏ b:a ∏ b, f:[a, b, c], c]
  a f b

show let uncurry₃ [
  a ∏ (b ∏ c):a ∏ (b ∏ c),
  f:[a, b, c, d], d]
  a f b c
