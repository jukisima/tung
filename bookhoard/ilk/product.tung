use flock/algebra/partial/category.tung
use flock/algebra/total/magma.tung
use flock/algebra/total/monoid.tung
use flock/algebra/total/semigroup.tung
use flock/functor.tung
use flock/functor/applicative.tung
use flock/functor/bifunctor.tung
use flock/functor/cata.tung
use flock/functor/monad.tung
use flock/functor/traverse.tung
use flock/order/lattice-distributive.tung
use flock/order/lattice.tung
use flock/order/semilattice-lower.tung
use flock/order/semilattice-upper.tung

show ilk ∏ [a:*, b:*, *] {
  ∏ [a, b, a ∏ b]
}

show let project₀ [@a:*, @b:*, a ∏ _:a ∏ b, a] a

show let project₁ [@a:*, @b:*, a ∏ b:a ∏ b, b] b

show let swap [@a:*, @b:*, a ∏ b:a ∏ b, b ∏ a] b ∏ a

bizen:∏ bifunctor {
  let (a ∏ b) bimap f g [] (a f) ∏ (b g)
}

bizen [@a:*]:(a ∏) functor {
  let þing map f [] þing bimap sameness f
}

bizen [byzen a monoid]:(a ∏) applicative {
  let b pure [] ∅ ∏ b
  let (a0 ∏ b) apply (a1 ∏ f) [] (a0 · a1) ∏ (b f)
}

bizen [byzen a monoid]:(a ∏) monad {
  let (a ∏ (b ∏ c)) flat []
    (a · b) ∏ c
}

bizen [@a:*]:(a ∏) cata {
  let (_ ∏ a) fold₀ b f [] a f b
  let (_ ∏ a) fold₁ b f [] b f a
}

bizen [@a:*]:(a ∏) traverse {
  let (a ∏ b) traverse f []
    (b f) map (a ∏)
}

bizen [byzen a semilattice-lower, byzen b semilattice-lower]:(a ∏ b) semilattice-lower {
  let (a₀ ∏ b₀) ∧ (a₁ ∏ b₁) [] (a₀ ∧ a₁) ∏ (b₀ ∧ b₁)
}

bizen [byzen a semilattice-upper, byzen b semilattice-upper]:(a ∏ b) semilattice-upper {
  let (a₀ ∏ b₀) ∨ (a₁ ∏ b₁) [] (a₀ ∨ a₁) ∏ (b₀ ∨ b₁)
}

bizen [byzen a lattice, byzen b lattice]:(a ∏ b) lattice {}

bizen [byzen a lattice-distributive, byzen b lattice-distributive]:(a ∏ b) lattice-distributive {}

show let uncurry [@a:*, @b:*, @c:*, a ∏ b:a ∏ b, f:[a, b, c], c]
  a f b

show let uncurry₃ [
  @a:*, @b:*, @c:*, @d:*,
  a ∏ (b ∏ c):a ∏ (b ∏ c),
  f:[a, b, c, d], d
] a f b c
