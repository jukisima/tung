## a powerset represented by its membership predicate.
show let-ilk a powerset = a func 𝟚

show let empty: a powerset = nay constant

show let universe: a powerset = yea constant

graith a equal
show let (a: a) singleton: a powerset = a ≡

fill (a powerset) inhold a {
  let powerset ∋ a = a powerset
}

graith a equal
show let (powerset: a powerset, a: a) put: a powerset = {
  b | (b ≡ a) ∨ (b powerset)
}

graith a equal
show let (powerset: a powerset, a: a) rid: a powerset = {
  b | (b ≡ a) if nay (b powerset)
}

show let (powerset₀: a powerset, powerset₁: a powerset) ∖: a powerset = {
  a | (a powerset₀) if (a powerset₁ $ if nay yea) nay
}

graith (a powerset) semilattice-infimal
fill ((a powerset) infimal) semigroup {
  let (a infimal) * (b infimal) = (a ∧ b) infimal
}

fill ((a powerset) infimal) monoid {
  let ∅ = universe infimal
}

fill (a powerset) complement {
  let powerset ¬ = powerset ∘ ¬
}
