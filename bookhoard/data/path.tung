use _foreign.tung
use data/one.tung
use algebra/total/magma.tung
use text/to-text.tung
use text/structure.tung

## a paþ kept distinct from arbitrary text at api boundaries.
show ilk paþ {
  text paþ
}

fill paþ to-text {
  let (text paþ) to-text = text
}

show let (text₀ paþ: paþ, text₁ paþ: paþ) join-paþ: paþ =
  text₀ * '/' $ * text₁ $ paþ

show let (text paþ: paþ) read-paþ: text ! file, text fail =
  text read-file

show let (text paþ: paþ, contents: text) write-paþ: 𝟙 ! file, text fail =
  text write-file contents

show let (text paþ: paþ, contents: text) append-paþ: 𝟙 ! file, text fail =
  text append-file contents
