use _foreign.tung
use data/one.tung

## a non-normalised span measured in milliseconds.
show ilk milliseconds {
  integer milliseconds
}

show let (value: integer) seconds: milliseconds =
  value × 1000 $ milliseconds

show let (value: integer) minutes: milliseconds =
  (value × 60) seconds


show let (value: integer) hours: milliseconds =
  (value × 60) minutes

show let (value milliseconds: milliseconds) sleep-for: 𝟙 ! async =
  value sleep
