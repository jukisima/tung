bring _foreign.tung;
bring data/one.tung;

## a non-normalised span measured in milliseconds.
show kin time-span {
  integer milliseconds
}

show let seconds: integer → time-span = {
  value | (value × 1000) milliseconds
};

show let minutes: integer → time-span = {
  value | (value × 60) seconds
};

show let hours: integer → time-span = {
  value | (value × 60) minutes
};

show let sleep-for: time-span → 𝟙 ! async = {
  value milliseconds | value sleep
}
