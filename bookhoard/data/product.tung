bring order/lattice.tung
bring algebra/total/magma.tung
bring algebra/total/semigroup.tung
bring algebra/total/monoid.tung
bring collection/functor.tung
bring collection/applicative.tung
bring collection/monad.tung
bring collection/catamorphism.tung
bring collection/traverse.tung

show kin a ∏ b {
  a ∏ b
}

show let (a ∏ _: a ∏ b) project₀: a = a

show let (a ∏ b: a ∏ b) project₁: b = b

show let (a ∏ b: a ∏ b) swap: b ∏ a = b ∏ a

show let (a ∏ b: a ∏ b, f: a → c ! e0, g: b → d ! e1) bimap: c ∏ d ! e0, e1 =
  (a f) ∏ (b g)

fill (a ∏) functor {
  let (a ∏ b) map f = a ∏ (b f)
}

graith a monoid
fill (a ∏) applicative {
  let b pure = ∅ ∏ b
  let (a0 ∏ b) apply (a1 ∏ f) = (a0 * a1) ∏ (b f)
}

graith a monoid
fill (a ∏) monad {
  let (a ∏ (b ∏ c)) flat =
    (a * b) ∏ c
}

fill (a ∏) cata {
  let (_ ∏ a) foldr b f = a f b
  let (_ ∏ a) foldl b f = b f a
}

fill (a ∏) traverse {
  let (a ∏ b) traverse f =
    (b f) map (a ∏)
  let (a ∏ b) sequence =
    b map (a ∏)
}

graith a semilattice-infimal, b semilattice-infimal
fill (a ∏ b) semilattice-infimal {
  let (a0 ∏ b0) ∧ (a1 ∏ b1) = (a0 ∧ a1) ∏ (b0 ∧ b1)
}

graith a semilattice-supremal, b semilattice-supremal
fill (a ∏ b) semilattice-supremal {
  let (a0 ∏ b0) ∨ (a1 ∏ b1) = (a0 ∨ a1) ∏ (b0 ∨ b1)
}

graith a lattice, b lattice
fill (a ∏ b) lattice {}
