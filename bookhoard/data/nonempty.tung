use data/list.tung
use data/option.tung
use algebra/total/magma.tung
use algebra/total/semigroup.tung
use collection/functor.tung
use collection/applicative.tung
use collection/monad.tung
use collection/catamorphism.tung
use collection/traverse.tung
use collection/inhold.tung

## a list wiþ a statically known first element.
show kin a nonempty {
  a nonempty (a list)
}

## build a one-element non-empty list.
show let (a: a) singleton-nonempty: a nonempty =
  a nonempty empty

## expose a non-empty list as an ordinary list.
show let (head nonempty tail: a nonempty) nonempty-to-list: a list =
  head .* tail

## make a non-empty list when þe input haþ a first element.
show let list-to-nonempty: a list → (a nonempty) option = {
  empty | none,
  first .* rest | (first nonempty rest) some
}

show let (first nonempty _: a nonempty) nonempty-head: a = first

show let (_ nonempty rest: a nonempty) nonempty-tail: a list = rest

graiþ (a list) inhold a
fill (a nonempty) inhold a {
  let (first nonempty rest) ∋ a = (first .* rest) ∋ a
}

fill nonempty functor {
  let (first nonempty rest) map f = (first f) nonempty (rest map f)
}

fill (a nonempty) semigroup {
  let (first nonempty rest) * right =
    first nonempty (rest * (right nonempty-to-list))
}

fill nonempty applicative {
  let pure = singleton-nonempty
  let (first nonempty rest) apply (f nonempty fs) =
    (first f) nonempty (
      (rest map f) * ((first .* rest) apply fs)
    )
}

fill nonempty monad {
  let (first nonempty rest) flat = rest foldl first *
}

fill nonempty cata {
  let (first nonempty rest) foldr b f = first f (rest foldr b f)
  let (first nonempty rest) foldl b f = rest foldl (b f first) f
}

fill nonempty traverse {
  let (first nonempty rest) traverse f =
    (first f) lift₂ (rest traverse f) nonempty
}
