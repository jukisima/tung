bring data/list.tung;
bring data/two.tung;
bring data/powerset.tung;
bring equal.tung;
bring collection/catamorphism.tung;
bring collection/inhold.tung;
bring collection/size.tung;
bring algebra/total/semigroup.tung;
bring algebra/total/monoid.tung;
bring order.tung;
bring order/lattice.tung;

## a list-backed finite set.
show kin a set {
  (a list) from-list
}

show let empty: a set = data/list@empty from-list;

show let (a: a) singleton: a set =
  (a .* data/list@empty) from-list;

show let (list from-list: a set) to-list: a list = list;

graith (a list) a inhold
fill (a set) a inhold {
  let (list from-list) ∋ a = list ∋ a
}

graith (a list) a inhold
show let (list from-list: a set, a: a) put: a set =
  (list ∋ a) if (list from-list) ((a .* list) from-list);

graith a equal
show let (list from-list: a set, a: a) rid: a set =
  list foldr data/list@empty {
    b, list′ | (a ≡ b) if list′ (b .* list′)
  } $ from-list;

graith (a list) a inhold
show let (list₀ from-list: a set, list₁ from-list: a set) ∖: a set =
  list₀ foldr data/list@empty {
    value, kept | (list₁ ∋ value) if kept (value .* kept)
  } $ from-list;

show let (values from-list: a set, predicate: a → 𝟚 ! e) keep: a set ! e =
  values foldr data/list@empty {
    value, kept | match value predicate {
      yea | value .* kept,
      nay | kept
    }
  } $ from-list;

graith (a list) a inhold
show let (values from-list: a set) to-powerset: a powerset = values ∋;

fill (a set) size {
  let (list from-list) size = list size
}

graith (a list) a inhold
fill (a set) equal {
  let (list₀ from-list) ≡ (list₁ from-list) =
    list₀ foldr yea {
      value, included | (list₁ ∋ value) if included nay
    } $ if (list₁ foldr yea {
        value, included | (list₀ ∋ value) if included nay
    }) nay
}

graith (a list) a inhold
fill (a set) less-equal {
  let (list₀ from-list) ≤ (list₁ from-list) =
    list₀ foldr yea {
      value, included | (list₁ ∋ value) if included nay
    }
}

graith (a list) a inhold
fill (a set) order-partial {}

graith (a list) a inhold
fill (a set) semigroup {
  let * = ∨
}

graith (a list) a inhold
fill (a set) monoid {
  let ∅ = empty
}

graith (a list) a inhold
fill (a set) semilattice-infimal {
  let (list₀ from-list) ∧ (list₁ from-list) =
    list₀ foldr data/list@empty {
      value, kept | (list₁ ∋ value) if (value .* kept) kept
    } $ from-list
}

graith (a list) a inhold
fill (a set) semilattice-supremal {
  let (list₀ from-list) ∨ (list₁ from-list) =
    list₁ foldl (list₀ from-list) put
}

graith (a list) a inhold
fill (a set) lattice {}

graith (a list) a inhold
fill (a set) semilattice-supremal-bounded {
  let ⟂ = empty
}
