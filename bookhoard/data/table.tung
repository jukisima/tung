use data/list.tung
use data/option.tung
use data/product.tung
use data/two.tung
use equal.tung
use collection/catamorphism.tung
use collection/functor.tung
use collection/filter.tung
use collection/inhold.tung
use collection/size.tung

## a list-backed finite association table.
show kin k table v {
  ((k ∏ v) list) from-list
}

show let empty: k table v = list@empty from-list

show let (key: k, value: v) singleton: k table v =
  key ∏ value $ .* list@empty $ from-list

show let (entries from-list: k table v) entries: (k ∏ v) list =
  entries

graiþ k equal
show let (entries from-list: k table v, key: k) lookup: v option =
  entries foldr none {
    pair, found | (key ≡ (pair project₀)) if (pair project₁ $ some) found
  }

graiþ k equal
show let (entries from-list: k table v, key: k, value: v) put: k table v =
  (key ∏ value) .* (entries foldr list@empty {
      pair, rest | (key ≡ (pair project₀)) if rest (pair .* rest)
  }) $ from-list

graiþ k equal
show let (entries from-list: k table v, key: k) rid: k table v =
  entries foldr list@empty {
    pair, rest | key ≡ (pair project₀) $ if rest (pair .* rest)
  } $ from-list

show let (entries from-list: k table v) keys: k list =
  entries map project₀

show let (entries from-list: k table v) values: v list =
  entries map project₁

graiþ (k list) inhold k
fill (k table v) inhold k {
  let table ∋ key = (table keys) ∋ key
}

fill (k table) functor {
  let (entries from-list) map f =
    entries map {
      pair | (pair project₀) ∏ (pair project₁ $ f)
    } $ from-list
}

fill (k table) filter {
  let (entries from-list) filter predicate =
    entries filter {
      pair | (pair project₁) predicate
    } $ from-list
}

fill (k table v) size {
  let table size = (table entries) size
}

graiþ k equal
show let (left: k table v, right: k table v) merge: k table v =
  (right entries) foldl left {
    table, pair | table put (pair project₀) (pair project₁)
  }

graiþ k equal
show let (entries from-list: k table v, key: k, change: v → v ! e) adjust: k table v ! e =
  entries foldr list@empty {
    pair, changed | match key ≡ (pair project₀) {
      yea | ((pair project₀) ∏ (pair project₁ $ change)) .* changed,
      nay | pair .* changed
    }
  } $ from-list
