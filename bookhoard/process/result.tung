## captured process status and standard streams.
show ilk process-result {
  ℤ process-result text text
}

show let (status process-result _ _: process-result)
  process-status: ℤ = status

show let (_ process-result output _: process-result)
  process-output: text = output

show let (_ process-result _ errors: process-result)
  process-errors: text = errors
