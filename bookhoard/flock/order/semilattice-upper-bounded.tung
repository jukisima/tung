use flock/order/semilattice-upper.tung
use ilk/three.tung
use ilk/two.tung

## a supremum semilattice wiþ a least value.
show flock semilattice-upper-bounded [byzen a semilattice-upper] {
  let ⟂ [a]
  law [a:a] ⟂ ∨ a = a
}

bizen [byzen b semilattice-upper-bounded, @a:*]:(a → b) semilattice-upper-bounded {
  let _ ⟂ [] ⟂
}

bizen:𝟚 semilattice-upper-bounded {
  let ⟂ [] nay
}

bizen:𝟛 semilattice-upper-bounded {
  let ⟂ [] fore
}
