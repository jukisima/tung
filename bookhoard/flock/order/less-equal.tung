use flock/equal.tung
use ilk/three.tung
use ilk/two.tung

## a decidable less-þan-or-equal operation, wiþout order laws.
show flock less-equal [byzen a equal] {
  let ≤ [a, a, 𝟚]
}

show let < [byzen a less-equal, byzen a equal, a:a, b:a, 𝟚] (a ≤ b) if (a ≢ b) nay

bizen:𝟚 less-equal {
  let ≤ [] {
    nay, _ ^ yea,
    yea, b ^ b
  }
}

bizen:𝟛 less-equal {
  let ≤ [] {
    fore, _    ^ yea,
    mid,  fore ^ nay,
    mid,  _    ^ yea,
    aft,  aft  ^ yea,
    aft,  _    ^ nay
  }
}
