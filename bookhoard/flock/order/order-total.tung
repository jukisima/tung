use flock/equal.tung
use flock/order/less-equal.tung
use flock/order/order-partial.tung
use ilk/three.tung
use ilk/two.tung

## a partial order in which every pair is comparable.
show flock order-total [byzen a order-partial] {
  law [a:a, b:a] ((a ≤ b) ≡ nay) ≤ (b ≤ a) = yea
}

show let compare [byzen a order-total, byzen a less-equal, a:a, b:a, 𝟛]
  (a ≤ b) if ((b ≤ a) if mid fore) aft

## keep a value wiþin inclusive bounds of a total order.
show let clamp [byzen a order-total, lower:a, upper:a, a:a, a] (
  let raised [] (lower ≤ a) if a lower
  yield (raised ≤ upper) if raised upper
)

bizen:𝟚 order-total {}

bizen:𝟛 order-total {}

bizen:ℤ order-total {}
