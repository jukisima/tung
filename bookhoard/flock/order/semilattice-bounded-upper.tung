use flock/order/semilattice-lower.tung
use ilk/three.tung
use ilk/two.tung

## an infimum semilattice wiþ a greatest value.
show flock semilattice-bounded-upper [byzen a semilattice-lower] {
  let ⊤ [a]

  law [a:a] ⊤ ∧ a = a
}

bizen [byzen b semilattice-bounded-upper, @a:*]:(a → b) semilattice-bounded-upper {
  let _ ⊤ [] ⊤
}

bizen:𝟚 semilattice-bounded-upper {
  let ⊤ [] yea
}

bizen:𝟛 semilattice-bounded-upper {
  let ⊤ [] aft
}
