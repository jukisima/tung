use flock/order/semilattice-lower.tung
use ilk/three.tung
use ilk/two.tung

## an infimum semilattice wiþ a greatest value.
graiþ a semilattice-lower
show flock semilattice-bounded-upper [a:ilk] (
  let ⊤ [a]

  law [a:a] ⊤ ∧ a = a
)

graiþ b semilattice-bounded-upper
bizen (a → b) semilattice-bounded-upper {
  let _ ⊤ ≔ ⊤
}

bizen 𝟚 semilattice-bounded-upper {
  let ⊤ ≔ yea
}

bizen 𝟛 semilattice-bounded-upper {
  let ⊤ ≔ aft
}
