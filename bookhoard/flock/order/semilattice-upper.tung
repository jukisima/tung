use flock/order/less-equal.tung
use flock/order/order-total.tung
use ilk/two.tung

## a carrier whose every pair haþ a supremum.
show flock semilattice-upper [a:ilk] (
  let ∨ [a, a, a]
  law [a:a] a ∨ a = a
  law [a:a, b:a] a ∨ b = b ∨ a
  law [a:a, b:a, c:a] (a ∨ b) ∨ c = a ∨ (b ∨ c)
)

graiþ b semilattice-upper
bizen (a → b) semilattice-upper {
  let f ∨ g a ≔ (a f) ∨ (a g)
}

graiþ a order-total
bizen a semilattice-upper {
  let a ∨ b ≔ (a ≤ b) if b a
}
