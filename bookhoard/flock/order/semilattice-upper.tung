use flock/order/less-equal.tung
use flock/order/order-total.tung
use ilk/two.tung

## a carrier whose every pair haþ a supremum.
show flock semilattice-upper [a:*] {
  let ∨ [a, a, a]
  law [a:a] a ∨ a = a
  law [a:a, b:a] a ∨ b = b ∨ a
  law [a:a, b:a, c:a] (a ∨ b) ∨ c = a ∨ (b ∨ c)
}

bizen [byzen b semilattice-upper, @a:*]:(a → b) semilattice-upper {
  let f ∨ g a [] (a f) ∨ (a g)
}

bizen [byzen a order-total]:a semilattice-upper {
  let a ∨ b [] (a ≤ b) if b a
}
