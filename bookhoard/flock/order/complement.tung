use flock/order/lattice-bounded.tung
use flock/order/semilattice-bounded-upper.tung
use flock/order/semilattice-lower.tung
use flock/order/semilattice-upper-bounded.tung
use flock/order/semilattice-upper.tung
use ilk/two.tung

## a bounded lattice wiþ a chosen complement for every value.
graiþ a lattice-bounded
show flock complement [a:ilk] (
  let ¬ [a, a]
  law [a:a] a ∧ (a ¬) = ⟂
  law [a:a] a ∨ (a ¬) = ⊤
)

bizen 𝟚 complement {
  let ¬ ≔ {
    yea ^ nay,
    nay ^ yea
  }
}
