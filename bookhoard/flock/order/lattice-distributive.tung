use flock/order/lattice.tung
use flock/order/order-total.tung
use flock/order/semilattice-lower.tung
use flock/order/semilattice-upper.tung

## a lattice whose infimum and supremum distribute over each oþer.
show flock lattice-distributive [byzen a lattice] {
  law [a:a, b:a, c:a]
    a ∧ (b ∨ c) = (a ∧ b) ∨ (a ∧ c)

  law [a:a, b:a, c:a]
    a ∨ (b ∧ c) = (a ∨ b) ∧ (a ∨ c)
}

bizen [byzen b lattice-distributive, @a:*]:(a → b) lattice-distributive {}

bizen [byzen a order-total]:a lattice-distributive {}
