use flock/order/order-total.tung
use flock/order/semilattice-lower.tung
use flock/order/semilattice-upper.tung

## a carrier wiþ compatible infimum and supremum semilattices.
show flock lattice [byzen a semilattice-lower, byzen a semilattice-upper] {
  law [a:a, b:a] a ∧ (a ∨ b) = a
  law [a:a, b:a] a ∨ (a ∧ b) = a
}

bizen [byzen b lattice, @a:*]:(a → b) lattice {}

bizen [byzen a order-total]:a lattice {}
