use _foreign.tung
use flock/algebra/arithmetic/divide.tung
use flock/algebra/arithmetic/multiply.tung
use flock/algebra/arithmetic/subtract.tung
use numeric/constant.tung

show flock elementary [byzen a divide] {
  let exponent [a, a]
  let logariþm [a, a]
  let sine [a, a]
  let cosine [a, a]
}

show let tangent [byzen a elementary, byzen a divide, a:a, a] (a sine) ÷ (a cosine)

bizen:float elementary {
  let exponent [] exponent-float
  let logariþm [] logariþm-float
  let sine [] sine-float
  let a cosine [] circumference × 0.25 $ - a $ sine
}
