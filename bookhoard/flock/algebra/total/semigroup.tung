use flock/algebra/total/magma.tung
use flock/order/semilattice-lower.tung
use flock/order/semilattice-upper.tung
use ilk/infimal.tung
use ilk/supremal.tung

show flock semigroup [byzen a magma] {
  law [a:a, b:a, c:a] a · (b · c) = (a · b) · c
}

show-ilk infimal, supremal
show infimal, supremal

bizen [byzen b semigroup, @a:*]:[a, b] semigroup {
  let f · g a [] (a f) · (a g)
}

bizen [byzen a semilattice-lower]:(a infimal) semigroup {
  let (a infimal) · (b infimal) [] (a ∧ b) infimal
}

bizen [byzen a semilattice-upper]:(a supremal) semigroup {
  let (a supremal) · (b supremal) [] (a ∨ b) supremal
}
