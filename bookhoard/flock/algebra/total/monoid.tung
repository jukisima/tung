use flock/algebra/total/magma.tung
use flock/algebra/total/semigroup.tung
use flock/order/semilattice-bounded-upper.tung
use flock/order/semilattice-upper-bounded.tung

show flock monoid [byzen a semigroup] {
  let ∅ [a]

  law [a:a] ∅ · a = a
  law [a:a] a · ∅ = a
}

bizen [byzen b monoid, @a:*]:[a, b] monoid {
  let _ ∅ [] ∅
}

bizen [byzen a semilattice-bounded-upper]:(a infimal) monoid {
  let ∅ [] ⊤ infimal
}

bizen [byzen a semilattice-upper-bounded]:(a supremal) monoid {
  let ∅ [] ⟂ supremal
}
