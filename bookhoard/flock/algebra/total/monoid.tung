use flock/algebra/total/magma.tung
use flock/algebra/total/semigroup.tung
use flock/order/semilattice-bounded-upper.tung
use flock/order/semilattice-upper-bounded.tung

graiþ a semigroup
show flock monoid [a:ilk] (
  let ∅ [a]

  law [a:a] ∅ * a = a
  law [a:a] a * ∅ = a
)

graiþ b monoid
bizen (a → b) monoid {
  let _ ∅ ≔ ∅
}

graiþ a semilattice-bounded-upper
bizen (a infimal) monoid {
  let ∅ ≔ ⊤ infimal
}

graiþ a semilattice-upper-bounded
bizen (a supremal) monoid {
  let ∅ ≔ ⟂ supremal
}
