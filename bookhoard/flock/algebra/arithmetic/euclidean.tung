use flock/algebra/arithmetic/add.tung
use flock/algebra/arithmetic/divide-remainder.tung
use flock/algebra/arithmetic/multiply.tung
use flock/algebra/arithmetic/ring.tung
use flock/algebra/arithmetic/subtract.tung
use flock/algebra/arithmetic/zero.tung
use flock/order/less-equal.tung
use flock/order/order-total.tung
use ilk/product.tung
use ilk/two.tung

## euclidean division, whose remainder lieþ between zero and þe divisor's
## absolute magnitude. each law shareþ þe operations' division-by-zero effect.
show flock euclidean [byzen a ring, byzen a divide-remainder, byzen a order-total] {
  law [dividend:a, divisor:a]
    match dividend % divisor {
      quotient ∏ rest ^ (quotient × divisor) + rest
    } = dividend + (zero × ((dividend % divisor) project₁))

  law [dividend:a, divisor:a]
    zero ≤ ((dividend % divisor) project₁)
      = match dividend % divisor {
        _ ∏ rest ^ rest ≤ rest
      }

  law [dividend:a, divisor:a]
    match dividend % divisor {
      _ ∏ rest ^ (zero ≤ divisor) if (rest < divisor) (rest < (zero - divisor))
    } = match dividend % divisor {
      _ ∏ rest ^ rest ≤ rest
    }
}

bizen:ℤ euclidean {}
