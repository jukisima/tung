use flock/algebra/arithmetic/semiring.tung
use flock/algebra/arithmetic/subtract.tung
use flock/algebra/arithmetic/zero.tung
use ilk/two.tung

show flock ring [byzen a semiring, byzen a subtract] {
  law [a:a] a - a = zero
}

bizen [byzen b ring, @a:*]:[a, b] ring {
  let f - g a [] (a f) - (a g)
}

bizen:ℤ ring {}

bizen:𝟚 ring {}
