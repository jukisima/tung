use flock/algebra/arithmetic/add.tung
use flock/algebra/arithmetic/monoid-additive.tung
use flock/algebra/arithmetic/monoid-multiplicative.tung
use flock/algebra/arithmetic/multiply.tung
use flock/algebra/arithmetic/one.tung
use flock/algebra/arithmetic/zero.tung
use ilk/two.tung

show flock semiring [byzen a monoid-additive, byzen a monoid-multiplicative] {
  law [a:a, b:a] a + b = b + a
  law [a:a, b:a, c:a] a × (b + c) = (a × b) + (a × c)
  law [a:a, b:a, c:a] (a + b) × c = (a × c) + (b × c)
  law [a:a, b:a] zero × a = zero
  law [a:a, b:a] a × zero = zero
}

bizen [byzen b semiring, @a:*]:[a, b] semiring {
  let f + g a [] (a f) + (a g)
  let _ zero [] zero
  let f × g a [] (a f) × (a g)
  let _ one [] one
}

bizen:𝟚 semiring {}
