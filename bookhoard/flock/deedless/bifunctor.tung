use flock/algebra/partial/category.tung
use flock/algebra/partial/semigroupoid.tung

## a binary type constructor covariant in boþ arguments.
show flock bifunctor [f:[*, *, *]] {
  let bimap [@a:*, @b:*, @c:*, @d:*, a f b, [a, c], [b, d], c f d]

  law [@a:*, @b:*, þing:a f b]
    þing bimap (sameness:[a, a]) (sameness:[b, b]) = þing

  law [@a₀:*, @a₁:*, @b₀:*, @b₁:*, @c₀:*, @c₁:*, þing:a₀ f a₁, f₀:[a₀, b₀], f₁:[a₁, b₁], g₀:[b₀, c₀], g₁:[b₁, c₁]]
    (þing bimap f₀ f₁) bimap g₀ g₁ = þing bimap (f₀ ∘ g₀) (f₁ ∘ g₁)
}

show let map-first [byzen f bifunctor, @a:*, @b:*, @c:*, afb:a f b, f:[a, c], c f b]
  afb bimap f sameness

show let map-oþer [byzen f bifunctor, @a:*, @b:*, @c:*, afb:a f b, f:[b, c], a f c]
  afb bimap sameness f
