use combinator.tung
use flock/algebra/partial/category.tung
use flock/algebra/partial/semigroupoid.tung
use flock/deedless/functor.tung

show flock applicative [byzen f functor] {
  let pure [@a:*, a, a f]
  let apply [@a:*, @b:*, a f, [a, b] f, b f]

  # sameness
  law [@a:*, a:a f]
    a apply ((sameness:[a, a]) pure) = a

  # homomorphism
  law [@a:*, @b:*, @e:*, a:a, f:[a, b; e]]
    (a pure) apply (f pure) = (a f) pure

  # composition
  law [@a:*, @b:*, @c:*, @e:*, a:a f, f:[a, b; e], g:[b, c; e]]
    <{apply, a, f pure, g pure} = <{apply, a, f ∘ g $ pure}

  # interchange
  law [@a:*, @b:*, @e:*, a:a, fs:[a, b; e] f]
    (a pure) apply fs = fs map (a call)
}

show let lift₂ [
  byzen f applicative, @a:*, @b:*, @c:*,
  a:a f, b:b f, f:[a, b, c],
  c f
] >{apply, b, a, f pure}

show let lift₃ [
  byzen f applicative, @a:*, @b:*, @c:*, @d:*,
  a:a f, b:b f, c:c f, f:[a, b, c, d],
  d f
] >{apply, c, b, a, f pure}

show let keep-first [
  byzen f applicative, @a:*, @b:*,
  a:a f, b:b f,
  a f
] a lift₂ b constant

show let keep-oþer [
  byzen f applicative, @a:*, @b:*,
  a:a f, b:b f,
  b f
] a lift₂ b (constant flip)
