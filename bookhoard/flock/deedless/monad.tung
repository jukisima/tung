use combinator.tung
use flock/deedless/applicative.tung
use flock/deedless/functor.tung
use ilk/one.tung

show flock monad [byzen f applicative] {
  let flat [@a:*, (a f) f, a f]

  law [@a:*, @b:*, a:a, f:[a, b f]]
    (a pure) map f $ flat = a f
  law [@a:*, a:a f]
    a map pure $ flat = a
}

show let map-flat [byzen f functor, byzen f monad, @a:*, @b:*, a:a f, f:[a, b f], b f]
  a map f $ flat

show let þen [byzen f monad, @a:*, @b:*, a:a f, b:b f, b f]
  a map-flat (b constant)

show let void [byzen f monad, @a:*, a:a f, 𝟙 f]
  a þen (only pure)
