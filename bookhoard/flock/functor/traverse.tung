use flock/algebra/partial/category.tung
use flock/functor.tung
use flock/functor/applicative.tung
use flock/functor/cata.tung

show flock traverse [byzen f functor, byzen f cata] {
  let traverse [byzen m applicative, @a:*, @b:*, a f, [a, b m], (b f) m]
}

show let sequence [byzen f traverse, byzen m applicative, @a:*, amf:(a m) f, (a f) m]
  amf traverse sameness
