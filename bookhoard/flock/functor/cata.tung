use flock/algebra/arithmetic/add.tung
use flock/algebra/arithmetic/monoid-additive.tung
use flock/algebra/arithmetic/monoid-multiplicative.tung
use flock/algebra/arithmetic/multiply.tung
use flock/algebra/arithmetic/one.tung
use flock/algebra/arithmetic/zero.tung
use flock/algebra/total/magma.tung
use flock/algebra/total/monoid.tung
use flock/algebra/total/semigroup.tung
use flock/order/semilattice-bounded-upper.tung
use flock/order/semilattice-lower.tung
use flock/order/semilattice-upper-bounded.tung
use flock/order/semilattice-upper.tung

show flock cata [f:[*, *]] {
  let fold₀ [@a:*, @b:*, @e:*, a f, b, [a, b, b; e], b; e]
  let fold₁ [@a:*, @b:*, @e:*, a f, b, [b, a, b; e], b; e]
}

show let …* [byzen a monoid, byzen f cata, l:a f, a] l fold₀ ∅ ·

## map values into a monoid and combine þem.
show let fold-map [byzen b monoid, byzen f cata, @a:*, @e:*, af:a f, f:[a, b; e], b; e]
  af fold₁ ∅ { folded, a ^ folded · (a f) }

## combine every value wiþ ∧; an empty collection yieldeþ ⊤.
show let …∧ [byzen f cata, byzen a semilattice-bounded-upper, af:a f, a] af fold₁ ⊤ ∧

## combine every value wiþ ∨; an empty collection yieldeþ ⟂.
show let …∨ [byzen f cata, byzen a semilattice-upper-bounded, af:a f, a] af fold₁ ⟂ ∨

## add every value in a foldable collection.
show let …+ [byzen f cata, byzen a monoid-additive, af:a f, a] af fold₁ zero +

## multiply every value in a foldable collection.
show let …× [byzen f cata, byzen a monoid-multiplicative, af:a f, a] af fold₁ one ×
