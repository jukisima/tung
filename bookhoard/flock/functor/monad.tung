use combinator.tung
use flock/functor.tung
use flock/functor/applicative.tung
use ilk/one.tung

show flock monad [byzen f applicative] {
  let flat [@a:*, (a f) f, a f]

  law [@a:*, @b:*, @e:*, a:a, f:[a, b f; e]]
    (a pure) map f $ flat = a f

  law [@a:*, a:a f]
    a map pure $ flat = a
}

show let map-flat [byzen f functor, byzen f monad, @a:*, @b:*, @e:*, a:a f, f:[a, b f; e], b f; e]
  a map f $ flat

show let þen [byzen f monad, @a:*, @b:*, a:a f, b:b f, b f]
  a map-flat (b constant)
