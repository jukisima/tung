use flock/algebra/arithmetic/subtract.tung
use flock/order/less-equal.tung
use ilk/two.tung

show flock absolute [a:*, b:*] {
  let absolute [a, b]
}

bizen:ℤ absolute ℤ {
  let integer absolute [] (0 ≤ integer) if integer (0 - integer)
}

bizen:float absolute float {
  let float absolute [] (0.0 ≤ float) if float (0.0 - float)
}
