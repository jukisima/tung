use ilk/table.tung
use ilk/text/structure.tung

## an http response wiþ its status, headers, and utf-8 body.
show ilk response {
  response [ℤ, text table text, text, response]
}

show let response-status [status response _ _:response, ℤ]
  status

show let response-headers [_ response headers _:response, text table text]
  headers

show let response-body [_ response _ body:response, text]
  body

show let respond [status:ℤ, body:text, response]
  status response empty body

show let ok [body:text, response] 200 respond body

show let not-found [body:text, response] 404 respond body

show let wiþ-header [
  status response headers body:response,
  name:text,
  value:text,
  response]
  status response (headers put name value) body
