use ilk/table.tung

## an incoming http request wiþ its meþod, target, headers, and utf-8 body.
show ilk request [*] {
  request [text, text, text table text, text, request]
}

show let request-meþod [meþod request _ _ _:request, text]
  meþod

show let request-target [_ request target _ _:request, text]
  target

show let request-headers
  [_ request _ headers _:request, text table text]
    headers

show let request-body [_ request _ _ body:request, text]
  body
