bring algebra/partial/semigroupoid.tung
bring algebra/partial/category.tung
bring collection/functor.tung
bring combinator.tung

graiþ f functor show shape f applicative {
  let a pure: a f
  let (a f) apply ((a → b ! e) f): b f ! e

  # identity
  law (a: a f):
    a apply ((identity: a → a) pure) ~ a

  # homomorphism
  law (a: a, f: a → b ! e):
    (a pure) apply (f pure) ~ (a f) pure

  # composition
  law (a: a f, f: a → b ! e, g: b → c ! e):
    <(apply, a, f pure, g pure) ~ <(apply, a, f ∘ g $ pure)

  # interchange
  law (a: a, fs: (a → b ! e) f):
    (a pure) apply fs ~ fs map (a into)
}

graiþ f applicative
show let (a: a f, b: b f, f: a → b → c ! e) lift₂: c f ! e =
  >(apply, b, a, f pure)

graiþ f applicative
show let (a: a f, b: b f, c: c f, f: a → b → c → d ! e) lift₃: d f ! e =
  >(apply, c, b, a, f pure)

graiþ f applicative
show let (a: a f, b: b f) keep-left: a f =
  b apply (a map { x, _ | x })

graiþ f applicative
show let (a: a f, b: b f) keep-right: b f =
  b apply (a map { _, y | y })
