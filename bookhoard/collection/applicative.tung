bring algebra/partial/category.tung
bring collection/functor.tung

graith f functor show shape f applicative {
  let a pure: a f
  let (a f) apply ((a → b ! e) f): b f ! e

  # identity
  law (a: a f):
    a apply ((identity: a → a) pure) ~ a
  # homomorphism
  law (a: a, f: a → b ! e):
    (a pure) apply (f pure) ~ (a f) pure
  # composition
  law (a: a f, f: a → b ! e, g: b → c ! e):
    (a apply (f pure)) apply (g pure) ~ a apply (({ x | x f $ g }) pure)
  # interchange
  law (a: a, fs: (a → b ! e) f):
    (a pure) apply fs ~ fs map { f | a f }
}

graith f applicative
show let (a: a f, b: b f, f: a → b → c ! e) lift₂: c f ! e =
  b apply (a apply (f pure))

graith f applicative
show let (a: a f, b: b f, c: c f, f: a → b → c → d ! e) lift₃: d f ! e =
  c apply (b apply (a apply (f pure)))

graith f applicative
show let (a: a f, b: b f) keep-left: a f =
  b apply (a map { x, _ | x })

graith f applicative
show let (a: a f, b: b f) keep-right: b f =
  b apply (a map { _, y | y })
