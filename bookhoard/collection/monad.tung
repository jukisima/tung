bring data/one.tung;
bring collection/functor.tung;
bring collection/applicative.tung;

graith f applicative
show shape f monad {
  ((a f) f) flat: a f;
  let (a: a f, f: a → b f ! e) map-flat : b f ! e =
    a map f $ flat

  law (a: a, f: a → b f ! e): (a pure) map-flat f ~ a f;
  law (a: a f): a map-flat pure ~ a
}

graith f monad
show let (a: a f, b: b f) then: b f =
  a map-flat { _ | b };

graith f monad
show let (a: a f) void: 𝟙 f =
  a map { _ | null }
