bring data/one.tung
bring combinator.tung
bring collection/functor.tung
bring collection/applicative.tung

graiþ f applicative
show shape f monad {
  let ((a f) f) flat: a f
  let (a: a f, f: a → b f ! e) map-flat: b f ! e =
    a map f $ flat

  law (a: a, f: a → b f ! e):
    (a pure) map-flat f ~ a f
  law (a: a f):
    a map-flat pure ~ a
}

graiþ f monad
show let (a: a f, b: b f) þen: b f =
  a map-flat (b constant)

graiþ f monad
show let (a: a f) void: 𝟙 f =
  a map (null constant)
