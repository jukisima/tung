bring algebra/total/magma.tung
bring algebra/total/semigroup.tung
bring algebra/total/monoid.tung
bring algebra/arithmetic/semiring.tung
bring order/lattice.tung

show shape f cata {
  let (a f) foldr b (a → b → b ! e): b ! e
  let (a f) foldl b (b → a → b ! e): b ! e
}

graiþ a monoid, f cata
show let (l: a f) fold: a = l foldr ∅ *

## map values into a monoid and combine þem.
graiþ b monoid, f cata
show let (þings: a f, f: a → b ! e) fold-map: b ! e =
  þings foldl ∅ { folded, þing | folded * (þing f) }

## combine every value wiþ ∧; an empty collection yieldeþ ⊤.
graiþ f cata, a semilattice-infimal-bounded
show let (þings: a f) …∧: a = þings foldl ⊤ ∧

## combine every value wiþ ∨; an empty collection yieldeþ ⟂.
graiþ f cata, a semilattice-supremal-bounded
show let (þings: a f) …∨: a = þings foldl ⟂ ∨

## add every value in a foldable collection.
graiþ f cata, a monoid-additive
show let (þings: a f) …+: a = þings foldl zero +

## multiply every value in a foldable collection.
graiþ f cata, a monoid-multiplicative
show let (þings: a f) …×: a = þings foldl one ×
