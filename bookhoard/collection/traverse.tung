use collection/applicative.tung
use collection/catamorphism.tung
use collection/functor.tung
use algebra/partial/category.tung

graiþ f functor, f cata
show frame f traverse {
  graiþ m applicative
  let (a f) traverse (a → b m): (b f) m
}

graiþ f traverse, m applicative
show let (amf: (a m) f) sequence: (a f) m =
  amf traverse identity
