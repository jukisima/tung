use algebra/partial/category.tung
use algebra/partial/semigroupoid.tung

## a binary type constructor covariant in boþ arguments.
show frame f bifunctor {
  let (a f b) bimap (a → c ! e₀) (b → d ! e₁): c f d ! e₀, e₁

  law (þing: a f b):
    þing bimap (identity: a → a) (identity: b → b) ~ þing

  law (þing: a₀ f a₁, f₀: a₀ → b₀, f₁: a₁ → b₁, g₀: b₀ → c₀, g₁: b₁ → c₁):
    (þing bimap f₀ f₁) bimap g₀ g₁ ~ þing bimap (f₀ ∘ g₀) (f₁ ∘ g₁)
}
