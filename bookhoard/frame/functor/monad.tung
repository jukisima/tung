use combinator.tung
use frame/functor.tung
use frame/functor/applicative.tung
use ilk/one.tung

graiþ f applicative
show frame f monad {
  let ((a f) f) flat: a f

  law (a: a, f: a → b f ! e):
    (a pure) map f $ flat ~ a f
  law (a: a f):
    a map pure $ flat ~ a
}

graiþ f monad, f functor
show let (a: a f, f: a → b f ! e) map-flat: b f ! e =
  a map f $ flat

graiþ f monad
show let (a: a f, b: b f) þen: b f =
  a map-flat (b constant)

graiþ f monad
show let (a: a f) void: 𝟙 f =
  a þen (only pure)
