use frame/algebra/partial/category.tung
use frame/functor.tung
use frame/functor/applicative.tung
use frame/functor/cata.tung

graiþ f functor, f cata
show frame f traverse {
  graiþ m applicative
  let (a f) traverse (a → b m): (b f) m
}

graiþ f traverse, m applicative
show let (amf: (a m) f) sequence: (a f) m =
  amf traverse sameness
