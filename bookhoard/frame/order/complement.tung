use frame/order/lattice-bounded.tung
use frame/order/semilattice-bounded-upper.tung
use frame/order/semilattice-lower.tung
use frame/order/semilattice-upper-bounded.tung
use frame/order/semilattice-upper.tung
use ilk/two.tung

## a bounded lattice wiþ a chosen complement for every value.
graiþ a lattice-bounded
show frame a complement {
  let a ¬: a
  law (a: a): a ∧ (a ¬) = ⟂
  law (a: a): a ∨ (a ¬) = ⊤
}

fill 𝟚 complement {
  let ¬ = {
    yea ^ nay,
    nay ^ yea
  }
}
