use frame/order/less-equal.tung
use frame/order/order-total.tung
use ilk/two.tung

## a carrier whose every pair haþ a supremum.
show frame a semilattice-upper {
  let a ∨ a: a
  law (a: a): a ∨ a = a
  law (a: a, b: a): a ∨ b = b ∨ a
  law (a: a, b: a, c: a): (a ∨ b) ∨ c = a ∨ (b ∨ c)
}

graiþ b semilattice-upper
fill (a func b) semilattice-upper {
  let f ∨ g a = (a f) ∨ (a g)
}

graiþ a order-total
fill a semilattice-upper {
  let a ∨ b = (a ≤ b) if b a
}
