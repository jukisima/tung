use frame/order/semilattice-upper.tung
use ilk/three.tung
use ilk/two.tung

## a supremum semilattice wiþ a least value.
graiþ a semilattice-upper
show frame a semilattice-upper-bounded {
  let ⟂ [a]
  law [a:a] ⟂ ∨ a = a
}

graiþ b semilattice-upper-bounded
fill (a → b) semilattice-upper-bounded {
  let _ ⟂ = ⟂
}

fill 𝟚 semilattice-upper-bounded {
  let ⟂ = nay
}

fill 𝟛 semilattice-upper-bounded {
  let ⟂ = fore
}
