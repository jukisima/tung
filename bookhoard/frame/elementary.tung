use _foreign.tung
use frame/algebra/arithmetic/divide.tung
use frame/algebra/arithmetic/multiply.tung
use frame/algebra/arithmetic/subtract.tung
use numeric/constant.tung

graiþ a divide
show frame a elementary {
  let exponent [a, a]
  let logariþm [a, a]
  let sine [a, a]
  let cosine [a, a]
}

graiþ a elementary, a divide
show let tangent [a:a, a] (a sine) ÷ (a cosine)

fill float elementary {
  let exponent = exponent-float
  let logariþm = logariþm-float
  let sine = sine-float
  let a cosine = circumference × 0.25 $ - a $ sine
}
