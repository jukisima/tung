use combinator.tung
use frame/deedless/applicative.tung
use frame/deedless/functor.tung
use ilk/one.tung

graiþ f applicative
show frame f monad {
  let ((a f) f) flat: a f

  law (a: a, f: a → b f):
    (a pure) map f $ flat = a f
  law (a: a f):
    a map pure $ flat = a
}

graiþ f functor, f monad
show let (a: a f, f: a → b f) map-flat: b f =
  a map f $ flat

graiþ f monad
show let (a: a f, b: b f) þen: b f =
  a map-flat (b constant)

graiþ f monad
show let (a: a f) void: 𝟙 f =
  a þen (only pure)
