use frame/algebra/order/semilattice-infimal-bounded.tung
use frame/algebra/order/semilattice-supremal-bounded.tung
use frame/algebra/partial/semigroup.tung
use frame/algebra/total/magma.tung

graiþ a semigroup
show frame a monoid {
  let ∅: a

  law (a: a): ∅ * a ~ a
  law (a: a): a * ∅ ~ a
}

graiþ b monoid
fill (a func b) monoid {
  let _ ∅ = ∅
}

graiþ a semilattice-infimal-bounded
fill (a infimal) monoid {
  let ∅ = ⊤ infimal
}

graiþ a semilattice-supremal-bounded
fill (a supremal) monoid {
  let ∅ = ⟂ supremal
}
