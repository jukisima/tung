use frame/algebra/total/magma.tung
use frame/algebra/total/semigroup.tung
use frame/order/semilattice-bounded-upper.tung
use frame/order/semilattice-upper-bounded.tung

graiþ a semigroup
show frame a monoid {
  let ∅: a

  law (a: a): ∅ * a ~ a
  law (a: a): a * ∅ ~ a
}

graiþ b monoid
fill (a func b) monoid {
  let _ ∅ = ∅
}

graiþ a semilattice-bounded-upper
fill (a infimal) monoid {
  let ∅ = ⊤ infimal
}

graiþ a semilattice-upper-bounded
fill (a supremal) monoid {
  let ∅ = ⟂ supremal
}
