bring combinator.tung;
bring data/two.tung;

show shape a add {
  a + a: a
}

show shape a zero {
  zero: a
}

graith a add, a zero
show shape a monoid-additive {
  law (a: a, b: a, c: a): a + (b + c) ~ (a + b) + c;
  law (a: a): zero + a ~ a;
  law (a: a): a + zero ~ a
}

show shape a multiply {
  a × a: a
}

show shape a one {
  one: a
}

graith a multiply, a one
show shape a monoid-multiplicative {
  law (a: a, b: a, c: a): a × (b × c) ~ (a × b) × c;
  law (a: a): one × a ~ a;
  law (a: a): a × one ~ a;
}

graith a monoid-additive, a monoid-multiplicative
show shape a semiring {
  law (a: a, b: a): a + b ~ b + a;
  law (a: a, b: a, c: a): a × (b + c) ~ (a × b) + (a × c);
  law (a: a, b: a, c: a): (a + b) × c ~ (a × c) + (b × c);
  law (a: a, b: a): zero × a ~ zero;
  law (a: a, b: a): a × zero ~ zero
}

graith b semiring
fill (a func b) semiring {
  let f + g = { a | (a f) + (a g) };
  let zero = { _ | zero };
  let f × g = { a | (a f) × (a g) };
  let one = { _ | one }
}

fill 𝟚 semiring {
  let + = {
    yea, nay | yea,
    nay, yea | yea,
    _, _ | nay
  };
  let zero = nay;
  let × = {
    yea, yea | yea,
    _, _ | nay
  };
  let one = yea
}
