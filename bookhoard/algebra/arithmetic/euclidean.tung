bring _foreign.tung;
bring data/two.tung;
bring data/product.tung;
bring order.tung;
bring algebra/arithmetic/semiring.tung;
bring algebra/arithmetic/ring.tung;

## euclidean quotient and remainder computed together.
show shape a divide-remainder {
  a ÷ a: a ∏ a ! text fail
}

## euclidean division, whose remainder lieth between zero and the divisor's
## absolute magnitude. each law shareth the operations' division-by-zero effect.
graith a ring, a divide-remainder, a order-total
show shape a euclidean {
  law (dividend: a, divisor: a):
    match dividend ÷ divisor {
      quotient ∏ rest | (quotient × divisor) + rest
    } ~ dividend + (zero × ((dividend ÷ divisor) project₁));
  law (dividend: a, divisor: a):
    zero ≤ ((dividend ÷ divisor) project₁)
      ~ match dividend ÷ divisor {
        _ ∏ rest | rest ≤ rest
      };
  law (dividend: a, divisor: a):
    match dividend ÷ divisor {
      _ ∏ rest | (zero ≤ divisor) if (rest < divisor) (rest < (zero - divisor))
    } ~ match dividend ÷ divisor {
      _ ∏ rest | rest ≤ rest
    }
}

fill integer divide-remainder {
  let ÷ = divide-remainder-integer
}

fill integer euclidean {}
