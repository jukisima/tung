bring algebra/arithmetic/semiring.tung;
bring data/two.tung;
bring _foreign.tung;

graith a add
show shape a subtract {
  a - a: a;
}

graith a semiring, a subtract
show shape a ring {
  law (a: a): a - a ~ zero
}

graith b ring
fill (a func b) ring {
  let f - g = { a | (a f) - (a g) }
}

fill integer subtract {
  let - = subtract-integer
}

fill float subtract {
  let - = subtract-float
}

fill integer ring {}

fill float ring {}

fill 𝟚 ring {
  let a + b = match a, b {
    yea, nay | yea,
    nay, yea | yea,
    _, _ | nay
  };
  let zero = nay;
  let a × b = match a, b {
    yea, yea | yea,
    _, _ | nay
  };
  let one = yea;
  let a - b = a + b
}
