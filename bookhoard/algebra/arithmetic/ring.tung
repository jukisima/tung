use algebra/arithmetic/semiring.tung
use data/two.tung
use _foreign.tung

graiþ a add
show frame a subtract {
  let a - a: a
}

graiþ a semiring, a subtract
show frame a ring {
  law (a: a): a - a ~ zero
}

graiþ b ring
fill (a func b) ring {
  let f - g a = (a f) - (a g)
}

fill integer subtract {
  let - = subtract-integer
}

fill float subtract {
  let - = subtract-float
}

fill integer ring {}

fill 𝟚 subtract {
  let - = +
}

fill 𝟚 ring {}
