bring _foreign.tung
bring algebra/arithmetic/semiring.tung
bring algebra/arithmetic/ring.tung

show shape a divide {
  let a ∕ a: a
}

graiþ a ring, a divide
show shape a field {
  law (dividend: a, divisor: a):
    (dividend ∕ divisor) × divisor ~ dividend
}

## ieee floats provide division, but rounding, infinities, and nan prevent a
## lawful field fill.
fill float divide {
  let ∕ = divide-float
}
