use _foreign.tung
use algebra/arithmetic/semiring.tung

fill ℤ add {
  let + = add-integer
}

fill ℤ zero {
  let zero = 0
}

fill ℤ multiply {
  let × = multiply-integer
}

fill ℤ one {
  let one = 1
}

fill ℤ monoid-additive {}

fill ℤ monoid-multiplicative {}

fill ℤ semiring {}

## ieee floats keep þeir useful operations wiþout claiming exact semiring laws.
fill float add {
  let + = add-float
}

fill float zero {
  let zero = 0.0
}

fill float multiply {
  let × = multiply-float
}

fill float one {
  let one = 1.0
}
