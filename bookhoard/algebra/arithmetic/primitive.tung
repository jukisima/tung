bring _foreign.tung;
bring algebra/arithmetic/semiring.tung;

fill integer add {
  let + = add-integer
}

fill integer zero {
  let zero = 0
}

fill integer multiply {
  let × = multiply-integer
}

fill integer one {
  let one = 1
}

fill integer monoid-additive {}

fill integer monoid-multiplicative {}

fill integer semiring {}

## ieee floats keep their useful operations without claiming exact semiring laws.
fill float add {
  let + = add-float
}

fill float zero {
  let zero = 0.0
}

fill float multiply {
  let × = multiply-float
}

fill float one {
  let one = 1.0
}
