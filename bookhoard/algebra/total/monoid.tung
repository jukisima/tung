bring algebra/total/magma.tung
bring algebra/total/semigroup.tung
bring data/two.tung
bring order/lattice.tung

graiþ a semigroup
show shape a monoid {
  let ∅: a

  law (a: a): ∅ * a ~ a
  law (a: a): a * ∅ ~ a
}

graiþ b monoid
fill (a func b) monoid {
  let _ ∅ = ∅
}

fill (𝟚 infimal) monoid {
  let ∅ = yea infimal
}

graiþ a semilattice-supremal-bounded
fill (a supremal) monoid {
  let ∅ = ⟂ supremal
}
