use algebra/total/magma.tung
use algebra/total/semigroup/infimal.tung
use algebra/total/semigroup/supremal.tung
use ilk/two.tung
use order/lattice.tung

graiþ a magma
show frame a semigroup {
  law (a: a, b: a, c: a): a * (b * c) ~ (a * b) * c
}

show-ilk infimal, supremal
show infimal, supremal

graiþ b semigroup
fill (a func b) semigroup {
  let f * g a = (a f) * (a g)
}

fill (𝟚 infimal) semigroup {
  let (a infimal) * (b infimal) = match a, b {
    nay, _ | _, nay @ nay infimal,
    _, _ @ yea infimal
  }
}

graiþ a semilattice-supremal
fill (a supremal) semigroup {
  let (a supremal) * (b supremal) = (a ∨ b) supremal
}
