use data/two.tung
use data/three.tung
use order.tung

## a carrier whose every pair haþ an infimum.
show frame a semilattice-infimal {
  let a ∧ a: a
  law (x: a): x ∧ x ~ x
  law (x: a, y: a): x ∧ y ~ y ∧ x
  law (x: a, y: a, z: a): (x ∧ y) ∧ z ~ x ∧ (y ∧ z)
}

graiþ b semilattice-infimal
fill (a func b) semilattice-infimal {
  let f ∧ g a = (a f) ∧ (a g)
}

graiþ a order-total
fill a semilattice-infimal {
  let a ∧ b = (a ≤ b) if a b
}

## a carrier whose every pair haþ a supremum.
show frame a semilattice-supremal {
  let a ∨ a: a
  law (x: a): x ∨ x ~ x
  law (x: a, y: a): x ∨ y ~ y ∨ x
  law (x: a, y: a, z: a): (x ∨ y) ∨ z ~ x ∨ (y ∨ z)
}

graiþ b semilattice-supremal
fill (a func b) semilattice-supremal {
  let f ∨ g a = (a f) ∨ (a g)
}

graiþ a order-total
fill a semilattice-supremal {
  let a ∨ b = (a ≤ b) if b a
}

## a carrier wiþ compatible infimum and supremum semilattices.
graiþ a semilattice-infimal, a semilattice-supremal
show frame a lattice {
  law (x: a, y: a): x ∧ (x ∨ y) ~ x
  law (x: a, y: a): x ∨ (x ∧ y) ~ x
}

graiþ b lattice
fill (a func b) lattice {}

graiþ a order-total
fill a lattice {}

## a lattice whose infimum and supremum distribute over each oþer.
graiþ a lattice
show frame a lattice-distributive {
  law (a: a, b: a, c: a):
    a ∧ (b ∨ c) ~ (a ∧ b) ∨ (a ∧ c)

  law (a: a, b: a, c: a):
    a ∨ (b ∧ c) ~ (a ∨ b) ∧ (a ∨ c)
}

graiþ b lattice-distributive
fill (a func b) lattice-distributive {}

graiþ a order-total
fill a lattice-distributive {}

## an infimum semilattice wiþ a greatest value.
graiþ a semilattice-infimal
show frame a semilattice-infimal-bounded {
  let ⊤: a
  law (a: a): ⊤ ∧ a ~ a
}

graiþ b semilattice-infimal-bounded
fill (a func b) semilattice-infimal-bounded {
  let _ ⊤ = ⊤
}

## a supremum semilattice wiþ a least value.
graiþ a semilattice-supremal
show frame a semilattice-supremal-bounded {
  let ⟂: a
  law (a: a): ⟂ ∨ a ~ a
}

graiþ b semilattice-supremal-bounded
fill (a func b) semilattice-supremal-bounded {
  let _ ⟂ = ⟂
}

## a lattice wiþ greatest and least values.
graiþ a lattice, a semilattice-infimal-bounded, a semilattice-supremal-bounded
show frame a lattice-bounded {}

graiþ b lattice-bounded
fill (a func b) lattice-bounded {}

## a bounded lattice wiþ a chosen complement for every value.
graiþ a lattice-bounded
show frame a complement {
  let a ¬: a
  law (a: a): a ∧ (a ¬) ~ ⟂
  law (a: a): a ∨ (a ¬) ~ ⊤
}

fill 𝟚 semilattice-infimal-bounded {
  let ⊤ = yea
}

fill 𝟚 semilattice-supremal-bounded {
  let ⟂ = nay
}

fill 𝟚 lattice-bounded {}

fill 𝟚 complement {
  let ¬ = {
    yea | nay,
    nay | yea
  }
}

fill 𝟛 semilattice-infimal-bounded {
  let ⊤ = aft
}

fill 𝟛 semilattice-supremal-bounded {
  let ⟂ = fore
}

fill 𝟛 lattice-bounded {}
