bring data/two.tung;
bring data/three.tung;

## a carrier whose every pair hath an infimum.
show shape a semilattice-infimum {
  a ∧ a: a;
  law (x: a): x ∧ x ~ x;
  law (x: a, y: a): x ∧ y ~ y ∧ x;
  law (x: a, y: a, z: a): (x ∧ y) ∧ z ~ x ∧ (y ∧ z)
}

graith b semilattice-infimum
fill (a func b) semilattice-infimum {
  let f ∧ g = { a | (a f) ∧ (a g) }
}

## a carrier whose every pair hath a supremum.
show shape a semilattice-supremum {
  a ∨ a: a;
  law (x: a): x ∨ x ~ x;
  law (x: a, y: a): x ∨ y ~ y ∨ x;
  law (x: a, y: a, z: a): (x ∨ y) ∨ z ~ x ∨ (y ∨ z)
}

graith b semilattice-supremum
fill (a func b) semilattice-supremum {
  let f ∨ g = { a | (a f) ∨ (a g) }
}

## a carrier with compatible infimum and supremum semilattices.
graith a semilattice-infimum, a semilattice-supremum
show shape a lattice {
  law (x: a, y: a): x ∧ (x ∨ y) ~ x;
  law (x: a, y: a): x ∨ (x ∧ y) ~ x
}

graith b lattice
fill (a func b) lattice {}

## an infimum semilattice with a greatest value.
graith a semilattice-infimum
show shape a semilattice-infimum-bounded {
  ⊤: a;
  law (value: a): ⊤ ∧ value ~ value
}

graith b semilattice-infimum-bounded
fill (a func b) semilattice-infimum-bounded {
  let ⊤ = { _ | ⊤ }
}

## a supremum semilattice with a least value.
graith a semilattice-supremum
show shape a semilattice-supremum-bounded {
  ⟂: a;
  law (value: a): ⟂ ∨ value ~ value
}

graith b semilattice-supremum-bounded
fill (a func b) semilattice-supremum-bounded {
  let ⟂ = { _ | ⟂ }
}

## a lattice with greatest and least values.
graith a lattice, a semilattice-infimum-bounded, a semilattice-supremum-bounded
show shape a lattice-bounded {}

graith b lattice-bounded
fill (a func b) lattice-bounded {}

## a bounded lattice with a chosen complement for every value.
graith a lattice-bounded
show shape a complement {
  a ¬: a;
  law (value: a): value ∧ (value ¬) ~ ⟂;
  law (value: a): value ∨ (value ¬) ~ ⊤
}

graith b complement
fill (a func b) complement {
  let f ¬ = { a | (a f) ¬ }
}

fill 𝟚 semilattice-infimum {
  let ∧ = {
    nay, _ | nay,
    yea, value | value
  }
}

fill 𝟚 semilattice-supremum {
  let ∨ = {
    yea, _ | yea,
    nay, value | value
  }
}

fill 𝟚 lattice {}

fill 𝟚 semilattice-infimum-bounded {
  let ⊤ = yea
}

fill 𝟚 semilattice-supremum-bounded {
  let ⟂ = nay
}

fill 𝟚 lattice-bounded {}

fill 𝟚 complement {
  let ¬ = {
    yea | nay,
    nay | yea
  }
}

fill three semilattice-infimum {
  let ∧ = {
    fore, _ | fore,
    mid, fore | fore,
    mid, _ | mid,
    aft, value | value
  }
}

fill three semilattice-supremum {
  let ∨ = {
    aft, _ | aft,
    mid, aft | aft,
    mid, _ | mid,
    fore, value | value
  }
}

fill three lattice {}

fill three semilattice-infimum-bounded {
  let ⊤ = aft
}

fill three semilattice-supremum-bounded {
  let ⟂ = fore
}

fill three lattice-bounded {}
