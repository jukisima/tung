bring _foreign.tung;
bring data/list.tung;
bring data/natural.tung;
bring data/option.tung;
bring data/two.tung;
bring collection/size.tung;
bring collection/catamorphism.tung;
bring collection/functor.tung;
bring collection/filter.tung;
bring algebra/total/semigroup.tung;
bring algebra/total/magma.tung;
bring order/lattice.tung;
bring text/structure.tung;

## true when text hath no unicode code points.
show let is-empty-text: text → 𝟚 = {
  value | match value behead-text {
    data/option@none | yea,
    _ data/option@some | nay
  }
};

## number of unicode code points, not bytes or utf-16 units.
show let text-length: text → natural = {
  value | (value text-to-list) size
};

show let (value: text, count: integer) take-text: text =
  ((value text-to-list) take count) list-to-text;

show let (value: text, count: integer) drop-text: text =
  ((value text-to-list) drop count) list-to-text;

show let reverse-text: text → text = {
  value | ((value text-to-list) reverse) list-to-text
};

show let (character: unicode, value: text) prepend-text: text =
  (character .* (value text-to-list)) list-to-text;

show let (value: text, character: unicode) append-text: text =
  ((value text-to-list) * (character .* empty)) list-to-text;

let (characters: unicode list, separates: unicode → 𝟚) split-unicode-by: (unicode list) list =
  match characters {
    empty | data/list@empty .* data/list@empty,
    character .* rest | match rest split-unicode-by separates {
      empty | (character .* data/list@empty) .* data/list@empty,
      current .* previous | match character separates {
        yea | data/list@empty .* (current .* previous),
        nay | (character .* current) .* previous
      }
    }
  };

let (characters: unicode list, separator: unicode) split-unicode: (unicode list) list =
  characters split-unicode-by { character |
    character equal-unicode separator
  };

let is-whitespace: unicode → 𝟚 = {
  character | match character equal-unicode `\{32} {
  yea | yea,
  nay | match character equal-unicode `\{9} {
  yea | yea,
  nay | match character equal-unicode `\{10} {
  yea | yea,
  nay | character equal-unicode `\{13}
}
}
}
};

## split text at each separator code point.
show let (value: text, separator: unicode) split-text: text list =
  ((value text-to-list) split-unicode separator) map list-to-text;

## split text on runs of common ascii whitespace.
show let words-text: text → text list = {
  value | (((value text-to-list) split-unicode-by is-whitespace) map list-to-text) filter {
    word | (word is-empty-text) ¬
  }
};

## join text values with a separator between neighbours.
show let (things: text list, separator: text) join-with-text: text = match things {
  empty | '',
  thing .* rest | rest foldl thing {
    joined, next | (joined join-text separator) join-text next
  }
}
